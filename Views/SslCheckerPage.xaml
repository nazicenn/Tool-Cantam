<UserControl x:Class="tool_cantam.Views.SslCheckerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.SslChecker.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Hedef -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.SslChecker.Target}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetTextBox"
                             Text="{Binding ViewModel.TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                             Width="280" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,10,0" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.SslChecker.TargetAutomationName}"/>

                    <Button Content="{DynamicResource L.SslChecker.Check}"
                            Command="{Binding ViewModel.CheckCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="32" MinWidth="100" TabIndex="1"/>
                </StackPanel>

                <TextBlock Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.SslChecker.Results}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.SummaryText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource OptionsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.Status}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewModel.CertificateStatus}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LabelPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsValid}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ViewModel.IsValid}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Subject -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.Subject}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.Subject}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- Issuer -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.Issuer}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.Issuer}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- Common Name -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.CommonName}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ViewModel.CommonName}"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                        <!-- Validity -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.Validity}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewModel.ValidityText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                        <!-- Remaining Days -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.RemainingDays}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ViewModel.RemainingDays}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- Serial -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.SerialNumber}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ViewModel.SerialNumber}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- Algorithm -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.SignatureAlgorithm}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ViewModel.SignatureAlgorithm}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- TLS Protocol -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.TlsProtocol}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ViewModel.TlsProtocol}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                        <!-- Chain Issues -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource L.SslChecker.Column.ChainIssues}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>

                        <ItemsControl Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding ViewModel.ChainIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource StatusDangerBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="15,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Alt bar -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Button Content="{DynamicResource L.SslChecker.Copy}"
                            Command="{Binding ViewModel.CopyResultsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="0,0,5,0" TabIndex="2"/>
                    <Button Content="{DynamicResource L.SslChecker.Save}"
                            Command="{Binding ViewModel.SaveResultCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="3"/>
                    <Button Content="{DynamicResource L.SslChecker.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="4"/>
                    <Button Content="{DynamicResource L.Common.Cancel}"
                            Command="{Binding ViewModel.CheckCancelCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusDangerBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,0,0" TabIndex="5"
                            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.StatusText}"
                               Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>