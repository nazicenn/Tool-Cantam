<UserControl x:Class="tool_cantam.Views.BcryptGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.BcryptGenerator.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.Label.Generate}" Style="{StaticResource LabelPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.Password}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ViewModel.Password}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="0"/>
                        <Button Grid.Column="1" Command="{Binding ViewModel.GenerateRandomPasswordCommand}" Content="{DynamicResource L.BcryptGenerator.Random}" Height="34" Width="100" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.WorkFactor}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                    <Slider Value="{Binding ViewModel.WorkFactor}" Minimum="4" Maximum="14" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" TabIndex="2"/>
                    <Button Command="{Binding ViewModel.HashCommand}" Content="{DynamicResource L.BcryptGenerator.Hash}" Height="36" Margin="0,0,0,8" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.Label.Hash}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource OptionsBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="80">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <TextBlock Text="{Binding ViewModel.HashedPassword}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Button Command="{Binding ViewModel.CopyHashCommand}" Content="{DynamicResource L.BcryptGenerator.Copy}" Height="30" Width="100" Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.Label.Verify}" Style="{StaticResource LabelPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource L.BcryptGenerator.Password}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ViewModel.VerifyPassword}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Margin="0,0,0,8" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="5"/>
                    <Button Command="{Binding ViewModel.VerifyCommand}" Content="{DynamicResource L.BcryptGenerator.Verify}" Height="36" Margin="0,0,0,10" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <Border CornerRadius="6" Padding="12" MinHeight="40">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource OptionsBgBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsVerified}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ViewModel.VerifyResult}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                    </Border>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.BcryptGenerator.Clear}" Height="34" Width="120" Margin="0,12,0,0" HorizontalAlignment="Right" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>