<!-- Views/IpCalculatorPage.xaml -->
<UserControl x:Class="tool_cantam.Views.IpCalculatorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="IP CALCULATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Input -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="IP Address:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas" Height="35" Margin="0,0,10,0"/>
                </Grid>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Command="{Binding CalculateCommand}" 
                            Content="CALCULATE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding LoadSampleCommand}" 
                            Content="SAMPLE" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyResultCommand}" 
                            Content="COPY" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Network Address:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding NetworkAddress}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subnet Mask:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SubnetMask}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wildcard Mask:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding WildcardMask}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Broadcast Address:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BroadcastAddress}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="First Usable:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FirstUsable}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Last Usable:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LastUsable}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas" Foreground="{StaticResource GreenBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Hosts:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalHosts}" Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Usable Hosts:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UsableHosts}" Style="{StaticResource LabelPrimary}" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                    </Grid>

                    <TextBlock Text="Binary" Style="{StaticResource LabelPrimary}" Margin="0,10,0,10"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BinaryIp}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mask:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BinaryMask}" Style="{StaticResource LabelPrimary}" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>