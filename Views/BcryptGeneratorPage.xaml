<!-- Views/BcryptGeneratorPage.xaml -->
<UserControl x:Class="tool_cantam.Views.BcryptGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="BCRYPT GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Generate ve Verify YAN YANA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: Generate -->
            <Border Grid.Column="0" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="GENERATE HASH" Style="{StaticResource LabelPrimary}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Password:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Password}" FontFamily="Consolas" Height="35"/>
                        <Button Grid.Column="2" Command="{Binding GenerateRandomPasswordCommand}" 
                                Content="RANDOM" Height="35" Width="80" Margin="10,0,0,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Work Factor:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Minimum="4" Maximum="14" Value="{Binding WorkFactor}"
                                TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding WorkFactor}" Width="40" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                    </Grid>

                    <Button Command="{Binding GenerateHashCommand}" 
                            Content="🔐 GENERATE HASH" Height="40" Margin="0,0,0,15"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>

                    <TextBlock Text="Hashed Password:" Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HashedPassword}" IsReadOnly="True" FontFamily="Consolas" 
                             TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,10"/>

                    <Button Command="{Binding CopyHashCommand}" 
                            Content="COPY HASH" Height="35" Width="120"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- SAĞ: Verify -->
            <Border Grid.Column="1" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="VERIFY PASSWORD" Style="{StaticResource LabelPrimary}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Password:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding VerifyPassword}" FontFamily="Consolas" Height="35"/>
                    </Grid>

                    <Button Command="{Binding VerifyCommand}" 
                            Content="🔍 VERIFY" Height="40" Margin="0,0,0,15"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>

                    <Border CornerRadius="6" Padding="12" Margin="0,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource StatusWarningBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding VerifyResult}" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="White" FontSize="14"/>
                    </Border>

                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR ALL" Height="35" Width="120" Margin="0,15,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>