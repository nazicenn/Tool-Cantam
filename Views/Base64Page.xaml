<UserControl x:Class="tool_cantam.Views.Base64Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:tool_cantam.Helpers"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.Base64.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource L.Input}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

                <TextBox Grid.Row="1"
                         x:Name="InputTextBox"
                         Text="{Binding ViewModel.InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"
                         VerticalAlignment="Stretch"
                         MinHeight="80"
                         TabIndex="0"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{DynamicResource L.Base64.InputAutomationName}"/>

                <TextBlock Grid.Row="2" Text="{DynamicResource L.Output}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

                <TextBox Grid.Row="3"
                         Text="{Binding ViewModel.OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"
                         VerticalAlignment="Stretch"
                         MinHeight="80"
                         TabIndex="1"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{DynamicResource L.Base64.OutputAutomationName}"/>

                <!-- Alfabe seçimi: standart (RFC 4648 §4) veya URL güvenli (RFC 4648 §5) -->
                <CheckBox Grid.Row="4"
                          Content="{DynamicResource L.Base64.UrlSafe}"
                          IsChecked="{Binding ViewModel.UseUrlSafeAlphabet}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,10"
                          TabIndex="2"
                          AutomationProperties.HelpText="{DynamicResource L.Base64.UrlSafeHelp}"/>

                <UniformGrid Grid.Row="5" Columns="5">
                    <Button Content="{DynamicResource L.Base64.Encode}"
                            Command="{Binding ViewModel.EncodeTextCommand}"
                            Height="34" Margin="0,0,5,0"
                            TabIndex="3"
                            Background="{StaticResource GreenBrush}" Style="{StaticResource ModernButton}"/>
                    <Button Content="{DynamicResource L.Base64.Decode}"
                            Command="{Binding ViewModel.DecodeTextCommand}"
                            Height="34" Margin="5,0,5,0"
                            TabIndex="4"
                            Background="{StaticResource GreenBrush}" Style="{StaticResource ModernButton}"/>
                    <Button Content="{DynamicResource L.Base64.Copy}"
                            Command="{Binding ViewModel.CopyOutputCommand}"
                            Height="34" Margin="5,0,5,0"
                            TabIndex="5"
                            Background="{StaticResource StatusWarningBrush}" Style="{StaticResource ModernButton}"/>
                    <Button Content="{DynamicResource L.Base64.Save}"
                            Command="{Binding ViewModel.SaveOutputCommand}"
                            Height="34" Margin="5,0,5,0"
                            TabIndex="6"
                            Background="{StaticResource AccentPrimaryBrush}" Style="{StaticResource ModernButton}"/>
                    <Button Content="{DynamicResource L.Base64.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Height="34" Margin="5,0,0,0"
                            TabIndex="7"
                            Background="{StaticResource RedBrush}" Style="{StaticResource ModernButton}"/>
                </UniformGrid>
            </Grid>

            <!-- Dosya bırakma alanı -->
            <Border Grid.Column="1" Style="{StaticResource DropZone}" VerticalAlignment="Stretch"
                    helpers:FileDragDropBehavior.IsEnabled="True"
                    helpers:FileDragDropBehavior.FilePath="{Binding ViewModel.FilePath, Mode=TwoWay}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Document24" FontSize="44" Margin="0,0,0,15"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource L.Base64.DropHint}"
                                   Style="{StaticResource DropZoneHint}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding ViewModel.FilePath}"
                                   Style="{StaticResource LabelSecondary}"
                                   FontSize="10" TextAlignment="Center" TextWrapping="Wrap"
                                   Opacity="0.7" Margin="10,0,10,25" MaxHeight="50"/>

                        <Button Content="{DynamicResource L.Base64.EncodeFile}"
                                Command="{Binding ViewModel.EncodeFileCommand}"
                                Height="38" Width="170" Margin="0,0,0,10"
                                TabIndex="8"
                                Background="{StaticResource AccentPrimaryBrush}" Style="{StaticResource ModernButton}"/>
                        <Button Content="{DynamicResource L.Base64.DecodeFile}"
                                Command="{Binding ViewModel.DecodeFileCommand}"
                                Height="38" Width="170"
                                TabIndex="9"
                                Background="{StaticResource GreenBrush}" Style="{StaticResource ModernButton}"/>

                        <!-- İşlem sürerken iptal imkânı -->
                        <Button Content="{DynamicResource L.Common.Cancel}"
                                Command="{Binding ViewModel.EncodeFileCancelCommand}"
                                Height="30" Width="170" Margin="0,10,0,0"
                                TabIndex="10"
                                Background="{StaticResource StatusDangerBrush}" Style="{StaticResource ModernButton}"
                                Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Durum çubuğu: renk, durum türüne göre temadan gelir -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:ProgressRing Grid.Column="0"
                             IsIndeterminate="True"
                             Width="16" Height="16"
                             Margin="0,0,8,0"
                             Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding ViewModel.StatusText}"
                       Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</UserControl>
