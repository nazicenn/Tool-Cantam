<!-- Views/CssGradientGeneratorPage.xaml -->
<UserControl x:Class="tool_cantam.Views.CssGradientGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="CSS GRADIENT GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Settings -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Color 1:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Color1}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Color 2:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Color2}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Direction:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Direction}" Height="35">
                        <ComboBoxItem>to right</ComboBoxItem>
                        <ComboBoxItem>to left</ComboBoxItem>
                        <ComboBoxItem>to bottom</ComboBoxItem>
                        <ComboBoxItem>to top</ComboBoxItem>
                        <ComboBoxItem>to bottom right</ComboBoxItem>
                        <ComboBoxItem>to top left</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <UniformGrid Columns="3" Margin="0,0,0,0">
                    <Button Command="{Binding GenerateCommand}" 
                            Content="GENERATE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding CopyCssCommand}" 
                            Content="COPY" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Preview & Output -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preview -->
            <Border Grid.Row="0" 
                    Padding="15" 
                    Margin="0,0,0,15"
                    Height="120">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding PreviewColor}"/>
                    </Style>
                </Border.Style>
            </Border>

            <!-- CSS Output -->
            <Border Grid.Row="1" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="CSS CODE" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                        <TextBox Text="{Binding GradientCss}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>