<UserControl x:Class="tool_cantam.Views.CertificateDecoderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.CertificateDecoder.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.CertificateDecoder.Label.Input}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ViewModel.CertificateInput, UpdateSourceTrigger=PropertyChanged}" Height="100" Padding="8,6" Margin="0,0,0,8" FontFamily="{StaticResource MonoFont}" FontSize="11" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TabIndex="0"/>
                <UniformGrid Columns="4">
                    <Button Command="{Binding ViewModel.DecodeCommand}" Content="{DynamicResource L.CertificateDecoder.Decode}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    <Button Command="{Binding ViewModel.LoadFileCommand}" Content="{DynamicResource L.CertificateDecoder.LoadFile}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <Button Command="{Binding ViewModel.CopyAllCommand}" Content="{DynamicResource L.CertificateDecoder.Copy}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.CertificateDecoder.Clear}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Version}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Version}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Serial}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SerialNumber}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Algorithm}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SignatureAlgorithm}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Issuer}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Issuer}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Subject}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Subject}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.ValidFrom}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.ValidFrom}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.ValidTo}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.ValidTo}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.PublicKey}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.PublicKeyAlgorithm}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.KeySize}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.PublicKeySize, StringFormat={}{0} bit}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Thumbprint}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Thumbprint}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.CertificateDecoder.Status}" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✗ Invalid"/>
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsValid}" Value="True">
                                                <Setter Property="Text" Value="✓ Valid"/>
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource L.CertificateDecoder.Label.Extensions}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ViewModel.Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>