<UserControl x:Class="tool_cantam.Views.IpInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.IpInfo.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Hedef -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.IpInfo.Target}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetTextBox"
                             Text="{Binding ViewModel.TargetIp, UpdateSourceTrigger=PropertyChanged}"
                             Width="280" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,10,0" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.IpInfo.TargetAutomationName}"/>

                    <Button Content="{DynamicResource L.IpInfo.Lookup}"
                            Command="{Binding ViewModel.LookupCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="32" MinWidth="100" TabIndex="1"/>
                </StackPanel>

                <TextBlock Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.IpInfo.Results}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.SummaryText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource OptionsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- IP -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Ip}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewModel.TargetIp}"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <!-- Family -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Family}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.AddressFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                        <!-- Country -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Country}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.Country}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Region -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Region}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ViewModel.Region}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- City -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.City}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewModel.City}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Zip -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Zip}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ViewModel.Zip}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Coordinates -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Coordinates}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ViewModel.Coordinates}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                        <!-- Timezone -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Timezone}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ViewModel.Timezone}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- ISP -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Isp}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ViewModel.Isp}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Org -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Org}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ViewModel.Org}"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- ASN -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource L.IpInfo.Column.Asn}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ViewModel.Asn}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Alt bar -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Button Content="{DynamicResource L.IpInfo.Copy}"
                            Command="{Binding ViewModel.CopyResultsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="0,0,5,0" TabIndex="2"/>
                    <Button Content="{DynamicResource L.IpInfo.Save}"
                            Command="{Binding ViewModel.SaveResultCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="3"/>
                    <Button Content="{DynamicResource L.IpInfo.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="4"/>
                    <Button Content="{DynamicResource L.Common.Cancel}"
                            Command="{Binding ViewModel.LookupCancelCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusDangerBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,0,0" TabIndex="5"
                            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.StatusText}"
                               Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>