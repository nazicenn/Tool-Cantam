<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="tool_cantam.Views.SubdomainPage"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık: Base64 sayfasındakiyle aynı stil -->
        <TextBlock Grid.Row="0" 
                   Text="SUBDOMAIN SCANNER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Ana İçerik -->
        <Border Grid.Row="1" 
                Padding="20">

            <StackPanel>
                <TextBlock Text="Target Domain" 
                           Style="{StaticResource LabelPrimary}" 
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input: Base64 sayfasındaki TextBox yapısına çekildi -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="{StaticResource MonoFont}"
                             Padding="12"
                             VerticalAlignment="Center"/>
                           

                    <!-- Scan Butonu: Base64 sayfasındaki ENCODE/DECODE butonları gibi GreenBrush yapıldı -->
                    <Button Grid.Column="1" 
                            Command="{Binding ScanCommand}"
                            Content="SCAN"
                            Height="42"
                            Width="100"
                            Margin="10,0,0,0"
                            Background="{StaticResource GreenBrush}"
                            Style="{StaticResource ModernButton}"/>
                </Grid>

                <!-- Durum ve Bulunan Sayısı -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding FoundCount, StringFormat=Found: \{0\}}" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontWeight="Bold"
                               FontSize="12"/>
                </Grid>

                <!-- Sonuç Listesi: Base64'teki çıktı alanlarına benzer şekilde düzenlendi -->
                <!-- Sonuç Listesi -->
                <!-- Sonuç Listesi -->
                <Border CornerRadius="8" 
        Background="Transparent" 
        BorderBrush="{StaticResource BorderDefaultBrush}" 
        BorderThickness="1"
        Height="280"
        Margin="0,15,0,0">

                    <ListBox x:Name="SubdomainsList"
             ItemsSource="{Binding Subdomains}"
                Background="{StaticResource BgDarkBrush}"
             BorderThickness="0"
             Padding="5" d:ItemsSource="{d:SampleData ItemCount=5}">

                        <!-- Her bir satırın kutucuk stili -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Hover: Üzerine gelince kenarlık yeşil olsun -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0A0A0A"/>
                                                </Trigger>
                                                <!-- Selected: Seçilince vurgulu kalsın -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0F0F0F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Metin rengi burada Beyaz (#FFFFFF) olarak ayarlandı -->
                                <TextBlock Text="{Binding}" 
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource MonoFont}"
                           FontWeight="SemiBold"
                           FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Alt Butonlar: Renkler Base64 sayfasıyla (Warning ve Red) eşitlendi -->
                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding CopyResultsCommand}" 
                            Content="COPY ALL"
                            Height="34" Margin="0,0,5,0"
                            Background="{StaticResource StatusWarningBrush}" 
                            Style="{StaticResource ModernButton}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR"
                            Height="34" Margin="5,0,0,0"
                            Background="{StaticResource RedBrush}" 
                            Style="{StaticResource ModernButton}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Footer Bilgi -->
        <TextBlock Grid.Row="2" 
                   Text="🔍 Subdomain scanning helps discover attack surface and forgotten services" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"
                   Opacity="0.7"/>
    </Grid>
</UserControl>