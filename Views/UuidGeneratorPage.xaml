<UserControl x:Class="tool_cantam.Views.UuidGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.UuidGenerator.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.UuidGenerator.Label.Count}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:NumberBox Grid.Column="1" Value="{Binding ViewModel.Count}"
              Minimum="1" Maximum="1000"
              ClearButtonEnabled="False"
              Width="130" TabIndex="0"
              AutomationProperties.Name="{DynamicResource L.UuidGenerator.Automation.Count}"/>
                    <TextBlock Grid.Column="3"
                               Text="{DynamicResource L.UuidGenerator.Label.Case}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding ViewModel.Cases}"
                              SelectedItem="{Binding ViewModel.Case}"
                              Width="130" Height="40" TabIndex="1"
                              AutomationProperties.Name="{DynamicResource L.UuidGenerator.Automation.Case}"/>
                </Grid>

                <WrapPanel>
                    <CheckBox Content="{DynamicResource L.UuidGenerator.IncludeHyphens}"
                              IsChecked="{Binding ViewModel.IncludeHyphens}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <CheckBox Content="{DynamicResource L.UuidGenerator.IncludeBraces}"
                              IsChecked="{Binding ViewModel.IncludeBraces}" Margin="0,0,0,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                </WrapPanel>

                <UniformGrid Columns="4" Margin="0,12,0,0">
                    <Button Command="{Binding ViewModel.GenerateCommand}"
                            Content="{DynamicResource L.UuidGenerator.Generate}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="4"
                            AutomationProperties.Name="{DynamicResource L.UuidGenerator.Automation.Generate}"/>
                    <Button Command="{Binding ViewModel.CopyOutputCommand}"
                            Content="{DynamicResource L.UuidGenerator.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="6"/>
                    <Button Command="{Binding ViewModel.SaveOutputCommand}"
                            Content="{DynamicResource L.UuidGenerator.Save}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="7"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.UuidGenerator.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="8"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource L.UuidGenerator.Label.Output}"
                           Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <TextBlock Text="{Binding ViewModel.Output}"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource L.UuidGenerator.Automation.Output}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>