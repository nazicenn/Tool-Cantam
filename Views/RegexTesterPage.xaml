<!-- Views/RegexTesterPage.xaml -->
<UserControl x:Class="tool_cantam.Views.RegexTesterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="REGEX TESTER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Pattern -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Regex Pattern" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Pattern}" FontFamily="Consolas" Height="35" Margin="0,0,0,10"/>

                <WrapPanel>
                    <CheckBox Content="Ignore Case" IsChecked="{Binding IgnoreCase}" Margin="0,0,20,5"/>
                    <CheckBox Content="Multiline" IsChecked="{Binding Multiline}" Margin="0,0,20,5"/>
                    <CheckBox Content="Replace Mode" IsChecked="{Binding ReplaceMode}" Margin="0,0,0,5"/>
                </WrapPanel>

                <Grid Margin="0,10,0,0" Visibility="{Binding ReplaceMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Replace with:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ReplaceText}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Command="{Binding TestCommand}" 
                            Content="TEST" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding LoadSampleCommand}" 
                            Content="SAMPLE" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>

                <TextBlock Margin="0,10,0,0">
                    <Run Text="Matches: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Run Text="{Binding MatchCount}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Input/Output -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="INPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Input}" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="OUTPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Output}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>