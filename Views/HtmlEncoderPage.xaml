<UserControl x:Class="tool_cantam.Views.HtmlEncoderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="HTML ENCODER / DECODER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid Grid.Column="0" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Input Text" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

                <TextBox Grid.Row="1" 
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         Margin="0,0,0,12"
                         VerticalAlignment="Stretch" 
                         MinHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderDefaultBrush}"/>

                <TextBlock Grid.Row="2" Text="Output Result" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

                <TextBox Grid.Row="3" 
                         Text="{Binding OutputText, Mode=OneWay}" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         Margin="0,0,0,12"
                         VerticalAlignment="Stretch" 
                         MinHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="{StaticResource AccentPrimaryBrush}"
                         BorderBrush="{StaticResource BorderDefaultBrush}"/>

                <UniformGrid Grid.Row="4" Columns="4">
                    <Button Content="ENCODE" Command="{Binding EncodeCommand}" 
                            Height="34" Margin="0,0,5,0"
                            Background="{StaticResource GreenBrush}" 
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="Bold"
                            Style="{StaticResource ModernButton}"/>
                    <Button Content="DECODE" Command="{Binding DecodeCommand}" 
                            Height="34" Margin="5,0,5,0"
                            Background="{StaticResource GreenBrush}" 
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="Bold"
                            Style="{StaticResource ModernButton}"/>
                    <Button Content="COPY" Command="{Binding CopyOutputCommand}" 
                            Height="34" Margin="5,0,5,0"
                            Background="{StaticResource StatusWarningBrush}" 
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="Bold"
                            Style="{StaticResource ModernButton}"/>
                    <Button Content="CLEAR" Command="{Binding ClearCommand}" 
                            Height="34" Margin="5,0,0,0"
                            Background="{StaticResource RedBrush}" 
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="Bold"
                            Style="{StaticResource ModernButton}"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- STATUS TEXT (ALTTA) -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>