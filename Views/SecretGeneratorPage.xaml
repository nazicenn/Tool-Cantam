<UserControl x:Class="tool_cantam.Views.SecretGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.SecretGenerator.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.SecretGenerator.Kind}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ViewModel.Kinds}" SelectedItem="{Binding ViewModel.Kind}" Height="34" Padding="8,4" TabIndex="0"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource L.SecretGenerator.Length}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                    <ui:NumberBox Grid.Column="3" Value="{Binding ViewModel.Length}" Minimum="8" Maximum="256" ClearButtonEnabled="False" Width="100" Height="34" Padding="8,4" TabIndex="1"/>
                    <TextBlock Grid.Column="4" Text="{DynamicResource L.SecretGenerator.Count}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                    <ui:NumberBox Grid.Column="5" Value="{Binding ViewModel.Count}" Minimum="1" Maximum="100" ClearButtonEnabled="False" Width="80" Height="34" Padding="8,4" TabIndex="2"/>
                </Grid>
                <UniformGrid Columns="5">
                    <Button Command="{Binding ViewModel.GenerateCommand}" Content="{DynamicResource L.SecretGenerator.Generate}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <Button Command="{Binding ViewModel.LoadSampleCommand}" Content="{DynamicResource L.SecretGenerator.Sample}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    <Button Command="{Binding ViewModel.CopySecretCommand}" Content="{DynamicResource L.SecretGenerator.Copy}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                    <Button Command="{Binding ViewModel.SaveSecretCommand}" Content="{DynamicResource L.SecretGenerator.Save}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.SecretGenerator.Clear}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource L.SecretGenerator.Label.Output}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{StaticResource OptionsBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <TextBlock Text="{Binding ViewModel.GeneratedSecret}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>