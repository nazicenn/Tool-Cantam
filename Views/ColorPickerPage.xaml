<!-- Views/ColorPickerPage.xaml -->
<UserControl x:Class="tool_cantam.Views.ColorPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="COLOR PICKER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Color Preview -->
            <Border Grid.Column="0" 
                    Width="120" 
                    Height="120" 
                    CornerRadius="8" 
                    Margin="0,0,20,0"
                    BorderBrush="{StaticResource BorderAccentBrush}"
                    BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{Binding SelectedColor}"/>
                </Border.Background>
            </Border>

            <!-- Color Values -->
            <Border Grid.Column="1" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX:" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding HexColor}" FontFamily="Consolas" Height="32"/>
                        <Button Grid.Column="2" Command="{Binding CopyHexCommand}" 
                                Content="COPY" Width="60" Margin="10,0,0,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"/>
                    </Grid>

                    <!-- RGB Sliders -->
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R:" Foreground="#FF5555" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Red}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G:" Foreground="#55FF55" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Green}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B:" Foreground="#5555FF" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Blue}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <Button Command="{Binding CopyRgbCommand}" 
                            Content="📋 COPY RGB" Height="32" Width="100" Margin="0,5,0,5"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>

                    <Border 
                            CornerRadius="6" Padding="10" Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock Text="HSL INFO" Style="{StaticResource LabelSecondary}" FontSize="11"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="H:" Style="{StaticResource LabelSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Hue}" FontFamily="Consolas" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="°"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="S:" Style="{StaticResource LabelSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Saturation}" FontFamily="Consolas" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="%"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="L:" Style="{StaticResource LabelSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Lightness}" FontFamily="Consolas" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="%"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CopyHslCommand}" 
                            Content="📋 COPY HSL" Height="32" Width="100" Margin="0,10,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>

                    <Button Command="{Binding PasteHexCommand}" 
                            Content="📋 PASTE HEX" Height="32" Width="100" Margin="0,5,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>