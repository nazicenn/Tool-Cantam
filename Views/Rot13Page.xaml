<UserControl x:Class="tool_cantam.Views.Rot13Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.Rot13.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Güvenlik uyarısı: bu araç şifreleme değildir -->
        <Border Grid.Row="1"
        Style="{StaticResource OptionsPanel}"
        BorderBrush="{StaticResource StatusWarningBrush}"
        BorderThickness="1"
        CornerRadius="4"
        Padding="12"
        Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24"
                       FontSize="18"
                       Foreground="{StaticResource StatusWarningBrush}"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource L.Rot13.Notice}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Kaydırma miktarı -->
        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource L.Rot13.Shift}"
                           Style="{StaticResource LabelPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Slider Grid.Column="1"
                        Minimum="1" Maximum="25"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ViewModel.Shift}"
                        VerticalAlignment="Center"
                        TabIndex="0"
                        AutomationProperties.Name="{DynamicResource L.Rot13.Shift}"
                        AutomationProperties.HelpText="{DynamicResource L.Rot13.ShiftHelp}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.Shift}"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"
                           MinWidth="34"
                           TextAlignment="Right"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource L.Input}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

            <TextBox Grid.Row="1"
                     x:Name="InputTextBox"
                     Text="{Binding ViewModel.InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     VerticalAlignment="Stretch"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="1"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderDefaultBrush}"
                     AutomationProperties.Name="{DynamicResource L.Rot13.InputAutomationName}"/>

            <Grid Grid.Row="2" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.Output}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource L.Rot13.Copy}"
                            Command="{Binding ViewModel.CopyOutputCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Height="26" FontSize="10" Padding="12,0"
                            Margin="0,0,6,0"
                            TabIndex="6"/>
                    <Button Content="{DynamicResource L.Rot13.Save}"
                            Command="{Binding ViewModel.SaveOutputCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Height="26" FontSize="10" Padding="12,0"
                            TabIndex="7"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="3"
                     Text="{Binding ViewModel.OutputText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     VerticalAlignment="Stretch"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="2"
                     Foreground="{StaticResource AccentPrimaryBrush}"
                     BorderBrush="{StaticResource BorderDefaultBrush}"
                     AutomationProperties.Name="{DynamicResource L.Rot13.OutputAutomationName}"/>

            <UniformGrid Grid.Row="4" Columns="5">
                <Button Content="{DynamicResource L.Rot13.Encode}"
                        Command="{Binding ViewModel.EncodeCommand}"
                        Height="34" Margin="0,0,5,0"
                        TabIndex="3"
                        Background="{StaticResource GreenBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.Rot13.Decode}"
                        Command="{Binding ViewModel.DecodeCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="4"
                        Background="{StaticResource GreenBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.Rot13.Swap}"
                        Command="{Binding ViewModel.SwapCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="5"
                        ToolTip="{DynamicResource L.Rot13.SwapHelp}"
                        Background="{StaticResource BorderDefaultBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.Rot13.Clear}"
                        Command="{Binding ViewModel.ClearCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="8"
                        Background="{StaticResource RedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.Common.Cancel}"
                        Command="{Binding ViewModel.EncodeCancelCommand}"
                        Height="34" Margin="5,0,0,0"
                        TabIndex="9"
                        Background="{StaticResource StatusDangerBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"
                        Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </UniformGrid>
        </Grid>

        <!-- DURUM SATIRI -->
        <Border Grid.Row="4"
                Style="{StaticResource OptionsPanel}"
                Padding="12"
                Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="True"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Grid.Column="2"
                           Text="{DynamicResource L.Rot13.Hint}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           MaxWidth="420"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
