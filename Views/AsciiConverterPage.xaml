<UserControl x:Class="tool_cantam.Views.AsciiConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.CharacterCodes.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Kod biçimi: ASCII bu kümenin ilk 128 karakteridir -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource L.CharacterCodes.Format}"
                           Style="{StaticResource LabelPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding ViewModel.Formats}"
                          SelectedItem="{Binding ViewModel.SelectedFormat}"
                          DisplayMemberPath="DisplayName"
                          Width="280"
                          TabIndex="0"
                          AutomationProperties.HelpText="{DynamicResource L.CharacterCodes.FormatHelp}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource L.Input}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

            <TextBox Grid.Row="1"
                     x:Name="InputTextBox"
                     Text="{Binding ViewModel.InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     VerticalAlignment="Stretch"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="1"
                     FontFamily="{StaticResource MonoFont}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderDefaultBrush}"
                     AutomationProperties.Name="{DynamicResource L.CharacterCodes.InputAutomationName}"/>

            <Grid Grid.Row="2" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.Output}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource L.CharacterCodes.Copy}"
                            Command="{Binding ViewModel.CopyOutputCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Height="26" FontSize="10" Padding="12,0"
                            Margin="0,0,6,0"
                            TabIndex="6"/>
                    <Button Content="{DynamicResource L.CharacterCodes.Save}"
                            Command="{Binding ViewModel.SaveOutputCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Height="26" FontSize="10" Padding="12,0"
                            TabIndex="7"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="3"
                     Text="{Binding ViewModel.OutputText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     VerticalAlignment="Stretch"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="2"
                     FontFamily="{StaticResource MonoFont}"
                     Foreground="{StaticResource AccentPrimaryBrush}"
                     BorderBrush="{StaticResource BorderDefaultBrush}"
                     AutomationProperties.Name="{DynamicResource L.CharacterCodes.OutputAutomationName}"/>

            <UniformGrid Grid.Row="4" Columns="5">
                <Button Content="{DynamicResource L.CharacterCodes.ToCodes}"
                        Command="{Binding ViewModel.ToCodesCommand}"
                        Height="34" Margin="0,0,5,0"
                        TabIndex="3"
                        Background="{StaticResource GreenBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.CharacterCodes.ToText}"
                        Command="{Binding ViewModel.ToTextCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="4"
                        Background="{StaticResource GreenBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.CharacterCodes.Swap}"
                        Command="{Binding ViewModel.SwapCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="5"
                        ToolTip="{DynamicResource L.CharacterCodes.SwapHelp}"
                        Background="{StaticResource BorderDefaultBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.CharacterCodes.Clear}"
                        Command="{Binding ViewModel.ClearCommand}"
                        Height="34" Margin="5,0,5,0"
                        TabIndex="8"
                        Background="{StaticResource RedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="{DynamicResource L.Common.Cancel}"
                        Command="{Binding ViewModel.ToCodesCancelCommand}"
                        Height="34" Margin="5,0,0,0"
                        TabIndex="9"
                        Background="{StaticResource StatusDangerBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButton}"
                        Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </UniformGrid>
        </Grid>

        <!-- DURUM SATIRI -->
        <Border Grid.Row="3"
                Style="{StaticResource OptionsPanel}"
                Padding="12"
                Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="True"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Grid.Column="2"
                           Text="{DynamicResource L.CharacterCodes.Hint}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           MaxWidth="420"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
