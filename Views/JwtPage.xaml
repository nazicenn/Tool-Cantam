<UserControl x:Class="tool_cantam.Views.JwtPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.Jwt.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Input -->
        <TextBlock Grid.Row="1" Text="{DynamicResource L.Jwt.InputLabel}"
                   Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>

        <TextBox Grid.Row="2"
                 x:Name="InputTextBox"
                 Text="{Binding ViewModel.JwtInput, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="80" MaxHeight="120"
                 Margin="0,0,0,12"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}"
                 TabIndex="0"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderDefaultBrush}"
                 AutomationProperties.Name="{DynamicResource L.Jwt.InputAutomationName}"/>

        <!-- Butonlar -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="5" Width="640" HorizontalAlignment="Left">
                <Button Content="{DynamicResource L.Jwt.Decode}"
                        Height="34" Margin="0,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource GreenBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Command="{Binding ViewModel.DecodeCommand}"
                        TabIndex="1"/>
                <Button Content="{DynamicResource L.Jwt.CopyHeader}"
                        Height="34" Margin="5,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Command="{Binding ViewModel.CopyHeaderCommand}"
                        TabIndex="2"/>
                <Button Content="{DynamicResource L.Jwt.CopyPayload}"
                        Height="34" Margin="5,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Command="{Binding ViewModel.CopyPayloadCommand}"
                        TabIndex="3"/>
                <Button Content="{DynamicResource L.Jwt.Save}"
                        Height="34" Margin="5,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentPrimaryBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Command="{Binding ViewModel.SavePayloadCommand}"
                        TabIndex="4"/>
                <Button Content="{DynamicResource L.Jwt.Clear}"
                        Height="34" Margin="5,0,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource RedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Command="{Binding ViewModel.ClearCommand}"
                        TabIndex="5"/>
            </UniformGrid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" HorizontalAlignment="Left" Margin="0,0,0,4"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>

        <!-- Token info -->
        <Border Grid.Row="4" Style="{StaticResource OptionsPanel}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource L.Jwt.Algorithm}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.Algorithm}" Style="{StaticResource LabelPrimary}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Margin="5,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding ViewModel.ExpiryStatus}" Foreground="{Binding ViewModel.ExpiryStatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="{DynamicResource L.Jwt.Expires}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock Grid.Column="4" Text="{Binding ViewModel.ExpiresAt}" Style="{StaticResource LabelPrimary}" FontFamily="{StaticResource MonoFont}" Margin="5,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5" Text="{DynamicResource L.Jwt.Type}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding ViewModel.TokenType}" Style="{StaticResource LabelPrimary}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Header + Payload -->
        <Grid Grid.Row="4" Margin="0,55,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource L.Jwt.HeaderLabel}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ViewModel.DecodedHeader, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{StaticResource MonoFont}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AccentPrimaryBrush}"
                                 AutomationProperties.Name="{DynamicResource L.Jwt.HeaderAutomationName}"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Payload -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource L.Jwt.PayloadLabel}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ViewModel.DecodedPayload, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{StaticResource MonoFont}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AccentPrimaryBrush}"
                                 AutomationProperties.Name="{DynamicResource L.Jwt.PayloadAutomationName}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Alt durum -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ViewModel.LimitsText}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Opacity="0.6"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>