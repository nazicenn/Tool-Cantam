<UserControl x:Class="tool_cantam.Views.FakeDataGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.FakeDataGenerator.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.FakeDataGenerator.Count}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:NumberBox Grid.Column="1" Value="{Binding ViewModel.Count}" Minimum="1" Maximum="100" ClearButtonEnabled="False" Width="100" Height="34" Padding="8,4" TabIndex="0"/>
                </Grid>
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox Content="{DynamicResource L.FakeDataGenerator.Name}" IsChecked="{Binding ViewModel.IncludeName}" Margin="0,0,16,4" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    <CheckBox Content="{DynamicResource L.FakeDataGenerator.Email}" IsChecked="{Binding ViewModel.IncludeEmail}" Margin="0,0,16,4" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <CheckBox Content="{DynamicResource L.FakeDataGenerator.Phone}" IsChecked="{Binding ViewModel.IncludePhone}" Margin="0,0,16,4" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <CheckBox Content="{DynamicResource L.FakeDataGenerator.Address}" IsChecked="{Binding ViewModel.IncludeAddress}" Margin="0,0,16,4" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    <CheckBox Content="{DynamicResource L.FakeDataGenerator.Company}" IsChecked="{Binding ViewModel.IncludeCompany}" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                </WrapPanel>
                <UniformGrid Columns="4">
                    <Button Command="{Binding ViewModel.GenerateCommand}" Content="{DynamicResource L.FakeDataGenerator.Generate}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <Button Command="{Binding ViewModel.CopyOutputCommand}" Content="{DynamicResource L.FakeDataGenerator.Copy}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                    <Button Command="{Binding ViewModel.SaveOutputCommand}" Content="{DynamicResource L.FakeDataGenerator.Save}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="8"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.FakeDataGenerator.Clear}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="9"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource L.FakeDataGenerator.Label.Output}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{StaticResource OptionsBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <TextBlock Text="{Binding ViewModel.Output}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>