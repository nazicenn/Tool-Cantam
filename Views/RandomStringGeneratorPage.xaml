<UserControl x:Class="tool_cantam.Views.RandomStringGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.RandomStringGenerator.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.RandomStringGenerator.Label.Length}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:NumberBox Grid.Column="1"
                                  Value="{Binding ViewModel.Length}"
                                  Minimum="4" Maximum="256"
                                  ClearButtonEnabled="False"
                                  Height="30" TabIndex="0"
                                  AutomationProperties.Name="{DynamicResource L.RandomStringGenerator.Automation.Length}"/>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource L.RandomStringGenerator.Label.Count}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <ui:NumberBox Grid.Column="3"
                                  Value="{Binding ViewModel.Count}"
                                  Minimum="1" Maximum="100"
                                  ClearButtonEnabled="False"
                                  Height="30" TabIndex="1"
                                  AutomationProperties.Name="{DynamicResource L.RandomStringGenerator.Automation.Count}"/>
                </Grid>

                <WrapPanel>
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.IncludeUpper}"
                              IsChecked="{Binding ViewModel.IncludeUppercase}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.IncludeLower}"
                              IsChecked="{Binding ViewModel.IncludeLowercase}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.IncludeDigits}"
                              IsChecked="{Binding ViewModel.IncludeDigits}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.IncludeSymbols}"
                              IsChecked="{Binding ViewModel.IncludeSymbols}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                </WrapPanel>

                <WrapPanel Margin="0,4,0,0">
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.ExcludeSimilar}"
                              IsChecked="{Binding ViewModel.ExcludeSimilar}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <CheckBox Content="{DynamicResource L.RandomStringGenerator.EnsureEachType}"
                              IsChecked="{Binding ViewModel.EnsureEachType}" Margin="0,0,0,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                </WrapPanel>

                <UniformGrid Columns="5" Margin="0,12,0,0">
                    <Button Command="{Binding ViewModel.GenerateCommand}"
                            Content="{DynamicResource L.RandomStringGenerator.Generate}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="8"
                            AutomationProperties.Name="{DynamicResource L.RandomStringGenerator.Automation.Generate}"/>
                    <Button Command="{Binding ViewModel.GenerateCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="9"
                            Visibility="{Binding ViewModel.GenerateCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding ViewModel.CopyOutputCommand}"
                            Content="{DynamicResource L.RandomStringGenerator.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="10"/>
                    <Button Command="{Binding ViewModel.SaveOutputCommand}"
                            Content="{DynamicResource L.RandomStringGenerator.Save}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="11"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.RandomStringGenerator.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="12"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource L.RandomStringGenerator.Label.Output}"
                           Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <TextBlock Text="{Binding ViewModel.Output}"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource L.RandomStringGenerator.Automation.Output}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>