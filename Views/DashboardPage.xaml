<UserControl x:Class="tool_cantam.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="TOOL CANTAM" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                <TextBlock Text="Professional Developer Toolkit" Style="{StaticResource LabelSecondary}" Margin="0,0,0,30"/>

                <ItemsControl x:Name="CategoriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="{Binding Key}" Style="{StaticResource LabelPrimary}" FontSize="16" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Value}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="250" Height="160" Margin="0,0,15,15"
                                                    Background="{StaticResource GrayBrush}"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                    MouseLeftButtonUp="Card_Click">
                                                <StackPanel Margin="20">
                                                    <TextBlock Text="🔧" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" Margin="0,0,0,10"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelPrimary}" FontSize="16"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource LabelSecondary}" 
                                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>