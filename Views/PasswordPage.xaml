<UserControl x:Class="tool_cantam.Views.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.Password.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: Generator -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Password.Settings}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <!-- Uzunluk -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource L.Password.Length}"
                                       Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.PasswordLength}"
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>
                        <Slider Value="{Binding ViewModel.PasswordLength}"
                                Minimum="4" Maximum="128"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,15" TabIndex="0"/>

                        <!-- Karakter setleri -->
                        <CheckBox Content="{DynamicResource L.Password.UseUpper}"
                                  IsChecked="{Binding ViewModel.UseUpper}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5" TabIndex="1"/>
                        <CheckBox Content="{DynamicResource L.Password.UseLower}"
                                  IsChecked="{Binding ViewModel.UseLower}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5" TabIndex="2"/>
                        <CheckBox Content="{DynamicResource L.Password.UseDigits}"
                                  IsChecked="{Binding ViewModel.UseDigits}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5" TabIndex="3"/>
                        <CheckBox Content="{DynamicResource L.Password.UseSymbols}"
                                  IsChecked="{Binding ViewModel.UseSpecial}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5" TabIndex="4"/>
                        <CheckBox Content="{DynamicResource L.Password.ExcludeSimilar}"
                                  IsChecked="{Binding ViewModel.ExcludeSimilar}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,15" TabIndex="5"/>

                        <Button Command="{Binding ViewModel.GenerateCommand}"
                                Content="{DynamicResource L.Password.Generate}"
                                Height="35" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource GreenBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="6"/>

                        <!-- Üretilen parola -->
                        <Border Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel.GeneratedPassword}"
                                           Style="{StaticResource LabelPrimary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           MinHeight="40"/>
                                <TextBlock Text="{Binding ViewModel.GeneratedStrength}"
                                           Foreground="{Binding ViewModel.GeneratedColor}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding ViewModel.CopyPasswordCommand}"
                                Content="{DynamicResource L.Password.Copy}"
                                Height="30"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="7"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- SAĞ: Strength Tester -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Password.StrengthTester}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="{DynamicResource L.Password.TestPassword}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="TxtTestPassword"
                                         Grid.Column="0"
                                         Height="35"
                                         Padding="12,8"
                                         FontFamily="{StaticResource MonoFont}"
                                         Background="{StaticResource OptionsBgBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderDefaultBrush}"
                                         PasswordChanged="TxtTestPassword_PasswordChanged"
                                         TabIndex="8"/>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource L.Password.ClearTest}"
                                    Width="70"
                                    Height="35"
                                    Margin="10,0,0,0"
                                    Command="{Binding ViewModel.ClearCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Background="{StaticResource RedBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TabIndex="9"/>
                        </Grid>

                        <!-- Strength Bar -->
                        <ProgressBar Value="{Binding ViewModel.StrengthPercent}"
             Maximum="100"
             Height="20"
             Foreground="{Binding ViewModel.StrengthColor}"
             Background="#1A1A1F"
             Margin="0,5,0,5"/>

                        <TextBlock Text="{Binding ViewModel.StrengthText}"
                                   Foreground="{Binding ViewModel.StrengthColor}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.Password.CrackTime}"
                                           Style="{StaticResource LabelSecondary}" FontSize="10"/>
                                <TextBlock Text="{Binding ViewModel.CrackTime}"
                                           Style="{StaticResource LabelPrimary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource L.Password.Entropy}"
                                           Style="{StaticResource LabelSecondary}" FontSize="10"/>
                                <TextBlock Text="{Binding ViewModel.EntropyBits, StringFormat={}{0} bits}"
                                           Style="{StaticResource LabelPrimary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bilgi -->
                        <Border Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,15,0,0">
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource L.Password.Hint}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Alt durum -->
        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>