<UserControl x:Class="tool_cantam.Views.MarkdownPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="MARKDOWN VIEWER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Buttons -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <UniformGrid Columns="4">
                <Button Command="{Binding ConvertCommand}" 
                        Content="CONVERT" Height="35" Margin="0,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource GreenBrush}"/>
                <Button Command="{Binding LoadSampleCommand}" 
                        Content="SAMPLE" Height="35" Margin="5,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"/>
                <Button Command="{Binding ClearCommand}" 
                        Content="CLEAR" Height="35" Margin="5,0,5,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource RedBrush}"/>
                <Button Command="{Binding CopyHtmlCommand}" 
                        Content="COPY HTML" Height="35" Margin="5,0,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"/>
            </UniformGrid>
        </Border>

        <!-- Input/Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Markdown -->
            <Border Grid.Column="0" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="MARKDOWN INPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding InputMarkdown, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="350"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="1" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="PREVIEW" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <WebBrowser x:Name="PreviewBrowser" MinHeight="350"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>