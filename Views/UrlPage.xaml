<UserControl x:Class="tool_cantam.Views.UrlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">                         
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="*"/>
            <!-- Ana İçerik -->
            <RowDefinition Height="Auto"/>
            <!-- Durum Satırı -->
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Grid.Row="0" 
                   Text="URL ENCODER / DECODER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Ana İçerik Bölgesi -->
        <Border Grid.Row="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: INPUT SECTION -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Label -->
                        <RowDefinition Height="*"/>
                        <!-- TextBox -->
                        <RowDefinition Height="Auto"/>
                        <!-- Button -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="INPUT TEXT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>

                    <TextBox Grid.Row="1" 
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="TextBox_TextChanged"/>

                    <Button Grid.Row="2" 
                            Content="ENCODE →" 
                            Command="{Binding EncodeCommand}" 
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Margin="0,15,0,0" 
                            Height="40"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- ORTA: SWAP BUTTON (Daha dengeli yerleşim) -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="15,30,15,0">
                    <Button Command="{Binding SwapCommand}"
                            Width="45" Height="45"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource BorderDefaultBrush}"
                            ToolTip="Swap Input and Output">
                        <TextBlock Text="⇄" FontSize="22" Foreground="{StaticResource AccentPrimaryBrush}"/>
                    </Button>
                </Grid>

                <!-- SAĞ: OUTPUT SECTION -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header (Label + Copy) -->
                        <RowDefinition Height="*"/>
                        <!-- TextBox -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom Buttons -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="RESULT" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                        <Button Content="COPY" 
                                Command="{Binding CopyOutputCommand}" 
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}" 
                                Height="26" FontSize="10" Padding="12,0"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBox Grid.Row="1" 
                             Text="{Binding OutputText, Mode=OneWay}" 
                             AcceptsReturn="True"
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"/>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,15,0,0">
                        <Button Content="← DECODE" 
                                Command="{Binding DecodeCommand}" 
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource GreenBrush}" 
                                Height="40" 
                                Margin="0,0,5,0"/>
                        <Button Content="CLEAR" 
                                Command="{Binding ClearCommand}" 
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource RedBrush}" 
                                Height="40" 
                                Margin="5,0,0,0"/>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- DURUM SATIRI (Footer) -->
        <Border Grid.Row="2" 
                Style="{StaticResource OptionsPanel}"
                Padding="12"
                Margin="0,15,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="URL encoding converts special characters to %xx format" 
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>