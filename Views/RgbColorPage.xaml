<UserControl x:Class="tool_cantam.Views.RgbColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.RgbColor.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.RgbColor.Red}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Red}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" TabIndex="0"/>
                    <ui:NumberBox Grid.Column="2" Value="{Binding ViewModel.Red}" Minimum="0" Maximum="255" ClearButtonEnabled="False" Height="34" Padding="8,4" TabIndex="1"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.RgbColor.Green}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Green}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" TabIndex="2"/>
                    <ui:NumberBox Grid.Column="2" Value="{Binding ViewModel.Green}" Minimum="0" Maximum="255" ClearButtonEnabled="False" Height="34" Padding="8,4" TabIndex="3"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.RgbColor.Blue}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Blue}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" TabIndex="4"/>
                    <ui:NumberBox Grid.Column="2" Value="{Binding ViewModel.Blue}" Minimum="0" Maximum="255" ClearButtonEnabled="False" Height="34" Padding="8,4" TabIndex="5"/>
                </Grid>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.RgbColor.Hex}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ViewModel.HexValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Margin="0,0,8,0" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="6"/>
                    <Button Grid.Column="2" Command="{Binding ViewModel.ApplyHexCommand}" Content="{DynamicResource L.RgbColor.Apply}" Height="34" Width="90" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                </Grid>
                <UniformGrid Columns="4" Margin="0,8,0,0">
                    <Button Command="{Binding ViewModel.RandomColorCommand}" Content="{DynamicResource L.RgbColor.Random}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="8"/>
                    <Button Command="{Binding ViewModel.CopyHexCommand}" Content="{DynamicResource L.RgbColor.CopyHex}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="9"/>
                    <Button Command="{Binding ViewModel.CopyRgbCommand}" Content="{DynamicResource L.RgbColor.CopyRgb}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="10"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.RgbColor.Clear}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="11"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.RgbColor.Preview}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <Border Height="120" CornerRadius="8" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="2">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding ViewModel.PreviewColor}"/>
                        </Border.Background>
                        <TextBlock Text="{Binding ViewModel.HexValue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{Binding ViewModel.PreviewTextColor}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource L.RgbColor.ColorInfo}" Style="{StaticResource LabelSecondary}" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding ViewModel.ColorInfo}" Style="{StaticResource LabelPrimary}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.RgbColor.Formats}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource L.RgbColor.Hex}" Style="{StaticResource LabelSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding ViewModel.HexValue}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="RGB" Style="{StaticResource LabelSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding ViewModel.RgbValue}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="HSL" Style="{StaticResource LabelSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding ViewModel.HslValue}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Button Command="{Binding ViewModel.CopyHslCommand}" Content="{DynamicResource L.RgbColor.CopyHsl}" Height="30" Width="110" HorizontalAlignment="Right" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>