<UserControl x:Class="tool_cantam.Views.RestApiClientPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.RestApi.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.RestApi.Method}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ViewModel.Methods}" SelectedItem="{Binding ViewModel.Method}" Width="100" Height="34" Padding="8,4" TabIndex="0"/>
                    <TextBox Grid.Column="2" Text="{Binding ViewModel.Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Margin="8,0,0,0" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="1"/>
                </Grid>
                <TextBlock Text="{DynamicResource L.RestApi.Headers}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ViewModel.Headers, UpdateSourceTrigger=PropertyChanged}" Height="60" Padding="8,6" Margin="0,0,0,8" FontFamily="{StaticResource MonoFont}" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TabIndex="2"/>
                <StackPanel Visibility="{Binding ViewModel.IsBodyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource L.RestApi.Body}" Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ViewModel.Body, UpdateSourceTrigger=PropertyChanged}" Height="80" Padding="8,6" Margin="0,0,0,8" FontFamily="{StaticResource MonoFont}" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TabIndex="3"/>
                </StackPanel>
                <UniformGrid Columns="6">
                    <Button Command="{Binding ViewModel.SendCommand}" Content="{DynamicResource L.RestApi.Send}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    <Button Command="{Binding ViewModel.LoadGetCommand}" Content="{DynamicResource L.RestApi.GetSample}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                    <Button Command="{Binding ViewModel.LoadPostCommand}" Content="{DynamicResource L.RestApi.PostSample}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <Button Command="{Binding ViewModel.CopyResponseCommand}" Content="{DynamicResource L.RestApi.Copy}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                    <Button Command="{Binding ViewModel.SaveResponseCommand}" Content="{DynamicResource L.RestApi.Save}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="8"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.RestApi.Clear}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="9"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource L.RestApi.Label.Headers}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ViewModel.ResponseHeaders}" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Header" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource L.RestApi.Status}" Style="{StaticResource LabelSecondary}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ViewModel.StatusCode}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource GreenBrush}"/>
                        <TextBlock Text="{Binding ViewModel.StatusDescription}" Style="{StaticResource LabelSecondary}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding ViewModel.ResponseTimeMs, StringFormat={}{0} ms}" Style="{StaticResource LabelSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource OptionsBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <TextBlock Text="{Binding ViewModel.ResponseBody}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>