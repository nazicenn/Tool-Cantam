<UserControl x:Class="tool_cantam.Views.TextDiffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.TextDiff.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Content="{DynamicResource L.TextDiff.IgnoreCase}"
                              IsChecked="{Binding ViewModel.IgnoreCase}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="0"/>
                    <CheckBox Content="{DynamicResource L.TextDiff.IgnoreWhitespace}"
                              IsChecked="{Binding ViewModel.IgnoreWhitespace}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    <CheckBox Content="{DynamicResource L.TextDiff.IgnoreEmptyLines}"
                              IsChecked="{Binding ViewModel.IgnoreEmptyLines}" Margin="0,0,0,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,15,0">
                        <Run Text="{DynamicResource L.TextDiff.Stats.Added}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding ViewModel.AddedLines}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,15,0">
                        <Run Text="{DynamicResource L.TextDiff.Stats.Removed}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding ViewModel.RemovedLines}" Foreground="{StaticResource RedBrush}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,15,0">
                        <Run Text="{DynamicResource L.TextDiff.Stats.Changed}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding ViewModel.ChangedLines}" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="{DynamicResource L.TextDiff.Stats.Unchanged}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding ViewModel.UnchangedLines}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    </TextBlock>
                </WrapPanel>

                <UniformGrid Columns="6" Margin="0,12,0,0">
                    <Button Command="{Binding ViewModel.CompareCommand}"
                            Content="{DynamicResource L.TextDiff.Compare}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="3"/>
                    <Button Command="{Binding ViewModel.CompareCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="4"
                            Visibility="{Binding ViewModel.CompareCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding ViewModel.SwapCommand}"
                            Content="{DynamicResource L.TextDiff.Swap}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="5"/>
                    <Button Command="{Binding ViewModel.CopyResultCommand}"
                            Content="{DynamicResource L.TextDiff.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="6"/>
                    <Button Command="{Binding ViewModel.SaveResultCommand}"
                            Content="{DynamicResource L.TextDiff.Save}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="7"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.TextDiff.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="8"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource L.TextDiff.Label.Original}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding ViewModel.LeftText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Padding="8" TabIndex="9"
                             AutomationProperties.Name="{DynamicResource L.TextDiff.Automation.Left}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource L.TextDiff.Label.Modified}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding ViewModel.RightText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Padding="8" TabIndex="10"
                             AutomationProperties.Name="{DynamicResource L.TextDiff.Automation.Right}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource L.TextDiff.Label.Diff}"
                           Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="8" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding ViewModel.DiffLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11">
                                        <Run Text="{Binding Sign}" FontWeight="Bold"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding LeftText}"/>
                                        <Run Text=" → " Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text="{Binding RightText}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>