<!-- Views/MxLookupPage.xaml -->
<UserControl x:Class="tool_cantam.Views.MxLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="MX LOOKUP" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Input -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Domain:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Domain}" FontFamily="Consolas" Height="35" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Command="{Binding LookupCommand}" 
                            Content="LOOKUP" Height="35" Width="80"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <Button Command="{Binding LoadSampleCommand}" 
                        Content="📋 SAMPLE" Height="35" Margin="0,10,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15">
            <StackPanel>
                <TextBlock Text="MX RECORDS" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding MxRecords}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Margin="0,0,0,10"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                        <DataGridTextColumn Header="Mail Server" Binding="{Binding Exchange}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Command="{Binding CopyResultsCommand}" 
                        Content="📋 COPY RESULTS" Height="35" Width="130" Margin="0,10,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>