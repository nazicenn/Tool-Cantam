    <sys:String x:Key="L.Base64.Title">BASE64 ENCODER / DECODER</sys:String>
    <sys:String x:Key="L.Base64.Encode">_ENCODE</sys:String>
    <sys:String x:Key="L.Base64.Decode">_DECODE</sys:String>
    <sys:String x:Key="L.Base64.Copy">_COPY</sys:String>
    <sys:String x:Key="L.Base64.Save">_SAVE</sys:String>
    <sys:String x:Key="L.Base64.Clear">C_LEAR</sys:String>
    <sys:String x:Key="L.Base64.EncodeFile">ENCODE FILE</sys:String>
    <sys:String x:Key="L.Base64.DecodeFile">DECODE FILE</sys:String>
