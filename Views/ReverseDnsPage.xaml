<UserControl x:Class="tool_cantam.Views.ReverseDnsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.ReverseDns.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Hedef -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.ReverseDns.Target}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetTextBox"
                             Text="{Binding ViewModel.TargetIp, UpdateSourceTrigger=PropertyChanged}"
                             Width="280" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,10,0" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.ReverseDns.TargetAutomationName}"/>

                    <Button Content="{DynamicResource L.ReverseDns.Lookup}"
                            Command="{Binding ViewModel.LookupCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="32" MinWidth="100" TabIndex="1"/>
                </StackPanel>

                <TextBlock Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.ReverseDns.Results}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.SummaryText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource OptionsBgBrush}"
                    BorderBrush="{StaticResource OptionsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- IP Address -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource L.ReverseDns.Column.Ip}"
                                   Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.TargetIp}"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontWeight="Bold"/>
                    </Grid>

                    <!-- Address Family -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource L.ReverseDns.Column.Family}"
                                   Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.AddressFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"/>
                    </Grid>

                    <!-- Hostname -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource L.ReverseDns.Column.Hostname}"
                                   Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.HostName}"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Aliases -->
                    <TextBlock Grid.Row="3"
                               Text="{DynamicResource L.ReverseDns.Column.Aliases}"
                               Style="{StaticResource LabelSecondary}"
                               Margin="0,8,0,4"
                               Visibility="{Binding ViewModel.HasAliases, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding ViewModel.Aliases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Margin="15,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Alt bar -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Button Content="{DynamicResource L.ReverseDns.Copy}"
                            Command="{Binding ViewModel.CopyResultCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="0,0,5,0" TabIndex="2"/>
                    <Button Content="{DynamicResource L.ReverseDns.Save}"
                            Command="{Binding ViewModel.SaveResultCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="3"/>
                    <Button Content="{DynamicResource L.ReverseDns.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="4"/>
                    <Button Content="{DynamicResource L.Common.Cancel}"
                            Command="{Binding ViewModel.LookupCancelCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusDangerBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,0,0" TabIndex="5"
                            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.StatusText}"
                               Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>