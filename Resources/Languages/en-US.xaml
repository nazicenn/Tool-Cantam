    <sys:String x:Key="L.Common.Cancel">CANCEL</sys:String>
    <sys:String x:Key="L.Common.Status.Cancelled">Operation cancelled.</sys:String>
    <sys:String x:Key="L.Common.Error.Cancelled">The operation was cancelled.</sys:String>
    <sys:String x:Key="L.Common.Error.Unexpected">An unexpected error occurred. See the log file for details.</sys:String>
    <sys:String x:Key="L.Common.Error.Clipboard">The clipboard could not be used. Another application may be holding it; please try again.</sys:String>
    <sys:String x:Key="L.Common.Error.FileSave">The file could not be saved.</sys:String>
    <sys:String x:Key="L.Common.Error.SettingsLoad">Settings could not be loaded; defaults are in use.</sys:String>
