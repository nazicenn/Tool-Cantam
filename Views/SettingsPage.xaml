<UserControl x:Class="tool_cantam.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:tool_cantam.Helpers"
    Background="{StaticResource BorderDefaultBrush}">

    <UserControl.Resources>
        <helpers:LangToColorConverter x:Key="LangToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="550">

                <TextBlock Text="{DynamicResource L.Settings}" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                <TextBlock Text="Configure your preferences" Style="{StaticResource LabelSecondary}" Margin="0,0,0,25"/>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Language}" Style="{StaticResource LabelPrimary}" FontSize="14"/>
                        <TextBlock Text="Select your preferred language" Style="{StaticResource LabelSecondary}" FontSize="11" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="English" Width="100" Style="{StaticResource ModernButton}"
                                    Background="{Binding SelectedLanguage, Converter={StaticResource LangToColorConverter}, ConverterParameter=English}"
                                    Margin="0,0,10,0"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="English"/>
                            <Button Content="Türkçe" Width="100" Style="{StaticResource ModernButton}"
                                    Background="{Binding SelectedLanguage, Converter={StaticResource LangToColorConverter}, ConverterParameter=Türkçe}"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="Türkçe"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.About}" Style="{StaticResource LabelPrimary}" FontSize="14"/>
                        <TextBlock Text="Tool Cantam v1.01 - Professional Developer Toolkit" Style="{StaticResource LabelSecondary}" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>