<!-- Views/GeoIpLookupPage.xaml -->
<UserControl x:Class="tool_cantam.Views.GeoIpLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="GEOIP LOOKUP" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Input -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="IP Address:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas" Height="35" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Command="{Binding LookupCommand}" 
                            Content="LOOKUP" Height="35" Width="80"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <Button Command="{Binding LookupMyIpCommand}" 
                        Content="📍 MY IP" Height="35" Margin="0,10,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15">
            <StackPanel>
                <TextBlock Text="LOCATION INFO" Style="{StaticResource LabelPrimary}" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Country:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Country}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="City:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding City}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Region:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Region}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ZIP Code:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding ZipCode}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <!-- Coordinates satırını düzelt -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Coordinates:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Latitude}" Style="{StaticResource LabelPrimary}"/>
                        <TextBlock Text=", " Style="{StaticResource LabelPrimary}"/>
                        <TextBlock Text="{Binding Longitude}" Style="{StaticResource LabelPrimary}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ISP:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Isp}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Organization:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Organization}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Timezone:" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Timezone}" Style="{StaticResource LabelPrimary}"/>
                </Grid>

                <Button Command="{Binding CopyResultsCommand}" 
                        Content="📋 COPY RESULTS" Height="35" Width="130" Margin="0,15,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>