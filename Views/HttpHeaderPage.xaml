<UserControl x:Class="tool_cantam.Views.HttpHeaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.HttpHeader.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource L.HttpHeader.Label.Url}"
                           Style="{StaticResource LabelSecondary}" Margin="0,0,0,6"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ViewModel.TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Padding="10,6"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.HttpHeader.Automation.Url}"/>
                    <Button Grid.Column="1"
                            Command="{Binding ViewModel.AnalyzeCommand}"
                            Content="{DynamicResource L.HttpHeader.Analyze}"
                            Height="35" Width="110" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="1"
                            AutomationProperties.Name="{DynamicResource L.HttpHeader.Automation.Analyze}"/>
                    <Button Grid.Column="2"
                            Command="{Binding ViewModel.AnalyzeCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Width="80" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="2"
                            Visibility="{Binding ViewModel.AnalyzeCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding ViewModel.SummaryText}"
                           Style="{StaticResource LabelSecondary}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Margin="0,0,0,6"/>

                <Border Grid.Row="2" Margin="0,20,0,0"
                        Background="{StaticResource OptionsBgBrush}"
                        CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.Headers}"
                                      AutomationProperties.Name="{DynamicResource L.HttpHeader.Automation.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BorderDefaultBrush}"
                                            CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontWeight="Bold" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding ViewModel.CopyResultsCommand}"
                            Content="{DynamicResource L.HttpHeader.Copy}"
                            Height="34" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="3"/>
                    <Button Grid.Column="1"
                            Command="{Binding ViewModel.SaveResultsCommand}"
                            Content="{DynamicResource L.HttpHeader.Save}"
                            Height="34" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="4"/>
                    <Button Grid.Column="2"
                            Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.HttpHeader.Clear}"
                            Height="34" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="5"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>