<UserControl x:Class="tool_cantam.Views.SubdomainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.Subdomain.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Hedef ve sınırlar -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.Subdomain.Target}"
                               Style="{StaticResource LabelPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetTextBox"
                             Text="{Binding ViewModel.TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,10,0" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.Subdomain.TargetAutomationName}"/>

                    <Button Content="{DynamicResource L.Subdomain.Scan}"
                            Command="{Binding ViewModel.ScanCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="32" MinWidth="100" TabIndex="1"/>
                </StackPanel>

                <TextBlock Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.Subdomain.Results}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.SummaryText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource OptionsBgBrush}"
                    BorderBrush="{StaticResource OptionsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ViewModel.Subdomains}"
                                  AutomationProperties.Name="{DynamicResource L.Subdomain.ResultsAutomationName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FullName}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontWeight="Bold"
                                               FontSize="12"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IpAddress}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt bar: butonlar + ilerleme + durum -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Button Content="{DynamicResource L.Subdomain.Copy}"
                            Command="{Binding ViewModel.CopyResultsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="0,0,5,0" TabIndex="2"/>
                    <Button Content="{DynamicResource L.Subdomain.Save}"
                            Command="{Binding ViewModel.SaveResultsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="3"/>
                    <Button Content="{DynamicResource L.Subdomain.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="4"/>
                    <Button Content="{DynamicResource L.Common.Cancel}"
                            Command="{Binding ViewModel.ScanCancelCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusDangerBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,0,0" TabIndex="5"
                            Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewModel.StatusText}"
                                   Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                                   FontSize="11" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar Height="4" Margin="0,4,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ViewModel.ProgressPercent}"
                                     Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ViewModel.ProgressText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>