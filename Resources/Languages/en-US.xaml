    <sys:String x:Key="L.Base64.Filter.Base64Files">Base64 files</sys:String>

    <sys:String x:Key="L.Base64.Status.Ready">Ready.</sys:String>
    <sys:String x:Key="L.Base64.Status.Encoded">Encoded: {0} character(s) to {1} Base64 character(s).</sys:String>
    <sys:String x:Key="L.Base64.Status.Decoded">Decoded: {0} character(s).</sys:String>
