<UserControl x:Class="tool_cantam.Views.PwnedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.Pwned.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="20">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Pwned.Prompt}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ViewModel.Password, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="8,6" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="0"/>
                    <Button Grid.Column="1" Command="{Binding ViewModel.CheckCommand}" Content="{DynamicResource L.Pwned.Check}" Height="40" Width="100" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                </Grid>

                <Border Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewModel.ResultText}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsPwned}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,12,0,0" Visibility="{Binding ViewModel.ShowSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Pwned.SuggestedLabel}" Style="{StaticResource LabelSecondary}" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewModel.SuggestedPassword}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,4,0,8"/>
                        <Button Command="{Binding ViewModel.UseSuggestionCommand}" Content="{DynamicResource L.Pwned.UseSuggestion}" Height="32" Width="200" HorizontalAlignment="Center" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding ViewModel.CopyResultCommand}" Content="{DynamicResource L.Pwned.Copy}" Height="35" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.Pwned.Clear}" Height="35" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                </UniformGrid>

                <TextBlock Text="{DynamicResource L.Pwned.Info}" Style="{StaticResource LabelSecondary}" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>