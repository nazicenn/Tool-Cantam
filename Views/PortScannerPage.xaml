<UserControl x:Class="tool_cantam.Views.PortScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="PORT SCANNER" 
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       FontSize="18" 
                       FontWeight="Bold"
                       FontFamily="{StaticResource MonoFont}"/>
            <TextBlock Text="Check open network ports for a specific host." 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="12" 
                       Margin="0,4,0,0"
                       FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>

        <!-- Ana Kart (Card stili) -->
        <Border Grid.Row="1" 
                Padding="15" 
                Margin="0,0,0,12">

            <StackPanel>
                <!-- Hedef IP -->
                <TextBlock Text="TARGET HOST / IP" 
                           Style="{StaticResource LabelPrimary}" 
                           FontSize="11" 
                           Margin="0,0,0,8"/>
                <ui:TextBox Text="{Binding ViewModel.TargetHost, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="127.0.0.1" 
                            Height="38" 
                            Margin="0,0,0,12"/>

                <!-- Port Aralığı -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="START PORT" 
                                   Style="{StaticResource LabelPrimary}" 
                                   FontSize="11" 
                                   Margin="0,0,0,5"/>
                        <ui:TextBox Text="{Binding ViewModel.StartPort}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="END PORT" 
                                   Style="{StaticResource LabelPrimary}" 
                                   FontSize="11" 
                                   Margin="0,0,0,5"/>
                        <ui:TextBox Text="{Binding ViewModel.EndPort}" Height="36"/>
                    </StackPanel>
                </Grid>

                <!-- Butonlar (ModernButton stili ile) -->
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Button Content="START SCAN" 
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}" 
                            Height="38" 
                            Margin="0,0,5,0"
                            Command="{Binding ViewModel.ScanCommand}"/>
                    <Button Content="CANCEL" 
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}" 
                            Height="38" 
                            Margin="5,0,0,0"
                            Command="{Binding ViewModel.CancelScanCommand}" 
                            Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <!-- Durum Çubuğu -->
                <Border Style="{StaticResource OptionsPanel}"
                        CornerRadius="6" 
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:ProgressRing IsIndeterminate="True" 
                                         Width="16" 
                                         Height="16" 
                                         Margin="0,0,10,0" 
                                         Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                         Foreground="{StaticResource AccentPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ViewModel.ScanStatus}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Timer24" 
                                           Margin="0,0,4,0" 
                                           Foreground="{StaticResource AccentPrimaryBrush}" 
                                           FontSize="14"/>
                            <TextBlock Text="{Binding ViewModel.ElapsedTime}" 
                                       Foreground="{StaticResource AccentPrimaryBrush}" 
                                       FontSize="11" 
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Port Listesi -->
        <ListBox Grid.Row="2" 
                 ItemsSource="{Binding ViewModel.OpenPorts}" 
                 Background="Transparent" 
                 BorderThickness="0" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource OptionsPanel}"
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="NetworkCheck24" 
                                           Foreground="{StaticResource AccentPrimaryBrush}" 
                                           Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Grid.Column="2" 
                                       Text="OPEN" 
                                       Foreground="{StaticResource GreenBrush}" 
                                       FontSize="10" 
                                       FontWeight="Black" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- SAVE LOG Butonu -->
        <Button Grid.Row="3" 
                Content="SAVE LOG" 
                Style="{StaticResource ModernButton}"
                Background="{StaticResource StatusWarningBrush}" 
                Height="40" 
                FontSize="12" 
                FontWeight="Bold" 
                Command="{Binding ViewModel.ExportReportCommand}"/>
    </Grid>
</UserControl>