<UserControl x:Class="tool_cantam.Views.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <UserControl.Resources>
        <!-- PasswordBox için ayrı stil -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="PASSWORD GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: Password Generator -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Password Settings" 
                               Style="{StaticResource LabelPrimary}" 
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Length:" 
                               Style="{StaticResource LabelSecondary}" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding PasswordLength}" 
                               Style="{StaticResource LabelPrimary}"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Slider Value="{Binding PasswordLength}" Minimum="8" Maximum="32" 
                            TickFrequency="1" IsSnapToTickEnabled="True" 
                            Foreground="{StaticResource AccentPrimaryBrush}"
                            Margin="0,0,0,15"/>

                    <CheckBox IsChecked="{Binding UseUpper}" Content="Uppercase (A-Z)" 
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>
                    <CheckBox IsChecked="{Binding UseLower}" Content="Lowercase (a-z)" 
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>
                    <CheckBox IsChecked="{Binding UseDigits}" Content="Digits (0-9)" 
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>
                    <CheckBox IsChecked="{Binding UseSpecial}" Content="Special (!@#$%^&amp;*)" 
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,15"/>

                    <Button Command="{Binding GenerateCommand}" 
                            Content="GENERATE"
                            Height="35" 
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}" 
                            Margin="0,0,0,10"/>

                    <Border Style="{StaticResource OptionsPanel}" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding GeneratedPassword}" 
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Button Command="{Binding CopyPasswordCommand}" 
                            Content="COPY"
                            Height="30"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </StackPanel>

                <!-- SAĞ: Strength Meter -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Password Strength Tester" 
                               Style="{StaticResource LabelPrimary}" 
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Test Password:" 
                               Style="{StaticResource LabelSecondary}" 
                               Margin="0,0,0,5"/>

                    <!-- PasswordBox ve Clear butonu için Grid -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="TxtTestPassword"
                                     Grid.Column="0"
                                     Height="35"
                                     PasswordChanged="TxtTestPassword_PasswordChanged"/>

                        <Button Grid.Column="1"
                                Content="CLEAR"
                                Width="80"
                                Height="35"
                                Margin="10,0,0,0"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusDangerBrush}"/>
                    </Grid>

                    <ProgressBar Value="{Binding StrengthPercent}" 
                                 Maximum="100" 
                                 Height="10"
                                 Foreground="{Binding StrengthColor}"
                                 Background="#1A1A1F"
                                 Margin="0,5,0,5"/>

                    <TextBlock Text="{Binding StrengthText}" 
                               Style="{StaticResource LabelPrimary}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <Border Style="{StaticResource OptionsPanel}" 
                            Margin="0,15,0,0" 
                            Padding="10">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            <Run Text="Strength Factors:"/><LineBreak/>
                            <Run Text="• 8+ characters (Weak → Strong)"/><LineBreak/>
                            <Run Text="• Uppercase + Lowercase"/><LineBreak/>
                            <Run Text="• Numbers + Special chars"/><LineBreak/>
                            <Run Text="• 16+ chars = Very Strong"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="Generate secure passwords or test existing passwords for strength"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>