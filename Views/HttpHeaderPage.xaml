<UserControl x:Class="tool_cantam.Views.HttpHeaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="HTTP HEADER ANALYZER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <StackPanel>
                <TextBlock Text="Target URL" 
                           Style="{StaticResource LabelPrimary}" 
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="example: https://google.com"/>

                    <Button Grid.Column="1" 
                            Command="{Binding AnalyzeCommand}"
                            Content="ANALYZE"
                            Height="40"
                            Width="100"
                            Margin="10,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <ui:ProgressRing IsIndeterminate="True" 
                                     Width="16" 
                                     Height="16" 
                                     Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Results List -->
                <Border Style="{StaticResource OptionsPanel}"
                        Margin="0,15,0,0"
                        Padding="10"
                        Height="350">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Headers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInputBrush}"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Key}" 
                                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                                       FontWeight="Bold"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Value}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding CopyResultsCommand}" 
                            Content="COPY RESULTS"
                            Height="34" 
                            Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR"
                            Height="34" 
                            Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="🌐 HTTP Header Analyzer - View security headers, server info, cache policies and more"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>