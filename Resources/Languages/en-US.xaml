    <sys:String x:Key="L.Common.Filter.TextFiles">Text files</sys:String>
    <sys:String x:Key="L.Common.Filter.AllFiles">All files</sys:String>

    <!-- ============ Ayarlar ============ -->
    <sys:String x:Key="L.Settings.LanguageChanged">Language updated.</sys:String>

