<UserControl x:Class="tool_cantam.Views.AesEncryptPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="AES ENCRYPT / DECRYPT" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Password:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Password}" FontFamily="Consolas" Height="35"/>
                    <Button Grid.Column="2" Command="{Binding GeneratePasswordCommand}" 
                            Content="RANDOM" Height="35" Width="90" Margin="10,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,0">
                    <Button Command="{Binding EncryptCommand}" 
                            Content="ENCRYPT →" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding DecryptCommand}" 
                            Content="← DECRYPT" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding SwapCommand}" 
                            Content="⇄ SWAP" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="INPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Height="280">
                        <TextBox Text="{Binding InputText}" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 BorderThickness="0"
                                 FontFamily="Consolas"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="OUTPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Height="280">
                        <TextBox Text="{Binding OutputText}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 BorderThickness="0"
                                 FontFamily="Consolas"/>
                    </ScrollViewer>

                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="30" Width="80" Margin="0,10,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>