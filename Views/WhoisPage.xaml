<UserControl x:Class="tool_cantam.Views.WhoisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="WHOIS LOOKUP" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <StackPanel>
                <TextBlock Text="Domain Name" 
                           Style="{StaticResource LabelPrimary}" 
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="example: google.com"/>

                    <Button Grid.Column="1" 
                            Command="{Binding LookupCommand}"
                            Content="LOOKUP"
                            Height="40"
                            Width="100"
                            Margin="10,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <ui:ProgressRing IsIndeterminate="True" 
                                     Width="16" 
                                     Height="16" 
                                     Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- SONUÇLAR - Visibility tamamen kaldırıldı, her zaman görünür -->
                <Border Style="{StaticResource OptionsPanel}"
                        Margin="0,15,0,0"
                        Padding="15">

                    <StackPanel>
                        <!-- Domain -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Domain:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.Domain}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontWeight="Bold"/>
                        </Grid>

                        <!-- Registrar -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Registrar:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.Registrar}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <!-- Creation Date -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Creation Date:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.CreationDate}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <!-- Expiration Date -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expiration Date:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.ExpirationDate}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <!-- Updated Date -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Updated Date:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.UpdatedDate}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <!-- Name Servers -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name Servers:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.NameServers}" 
                                       Style="{StaticResource LabelPrimary}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Status -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.Status}" 
                                       Style="{StaticResource LabelPrimary}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Owner -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Owner:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.Owner}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <!-- Country -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Country:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WhoisInfo.OwnerCountry}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Butonlar -->
                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding CopyResultsCommand}" 
                            Content="COPY ALL"
                            Height="34" 
                            Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR"
                            Height="34" 
                            Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="🔍 WHOIS Lookup - Get domain registration information (registrar, dates, name servers)" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>