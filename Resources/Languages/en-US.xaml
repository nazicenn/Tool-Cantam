    <sys:String x:Key="L.Base64.Validation.EmptyInput">Please enter text to convert.</sys:String>
    <sys:String x:Key="L.Base64.Validation.NothingToCopy">There is no output to copy.</sys:String>
    <sys:String x:Key="L.Base64.Validation.NothingToSave">There is no output to save.</sys:String>

    <sys:String x:Key="L.Base64.Error.InvalidCharacter">Invalid Base64 input: unexpected character.</sys:String>
    <sys:String x:Key="L.Base64.Error.InvalidLength">Invalid Base64 input: the payload length is not valid.</sys:String>
    <sys:String x:Key="L.Base64.Error.InvalidPadding">Invalid Base64 input: padding characters are misplaced.</sys:String>
    <sys:String x:Key="L.Base64.Error.InvalidFormat">Invalid Base64 input.</sys:String>
    <sys:String x:Key="L.Base64.Error.NotUtf8Text">The decoded bytes are not valid UTF-8 text. Use "Decode file" for binary data.</sys:String>
    <sys:String x:Key="L.Base64.Error.InputTooLarge">Input is too large. The limit is 10 MB of text.</sys:String>
    <sys:String x:Key="L.Base64.Error.OutputTooLarge">The decoded result would be too large. The limit is 10 MB.</sys:String>
    <sys:String x:Key="L.Base64.Error.PathRequired">A file path is required.</sys:String>
    <sys:String x:Key="L.Base64.Error.FileNotFound">The selected file could not be found.</sys:String>
    <sys:String x:Key="L.Base64.Error.InvalidFileContent">The file does not contain valid Base64 data.</sys:String>
    <sys:String x:Key="L.Base64.Error.IoError">The file could not be read or written. Check permissions and free disk space.</sys:String>

