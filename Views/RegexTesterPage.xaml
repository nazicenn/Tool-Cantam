<UserControl x:Class="tool_cantam.Views.RegexTesterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.RegexTester.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.RegexTester.Label.Pattern}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ViewModel.Pattern, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Height="32" Padding="8" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.RegexTester.Automation.Pattern}"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding ViewModel.Samples}"
                              SelectedItem="{Binding ViewModel.Samples/}"
                              Width="120" Height="30" Margin="8,0,0,0"
                              TabIndex="1"
                              DisplayMemberPath="Key"
                              AutomationProperties.Name="{DynamicResource L.RegexTester.Automation.Samples}"/>
                </Grid>

                <WrapPanel Margin="0,4,0,8">
                    <CheckBox Content="{DynamicResource L.RegexTester.IgnoreCase}"
                              IsChecked="{Binding ViewModel.IgnoreCase}" Margin="0,0,16,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <CheckBox Content="{DynamicResource L.RegexTester.Multiline}"
                              IsChecked="{Binding ViewModel.Multiline}" Margin="0,0,16,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <CheckBox Content="{DynamicResource L.RegexTester.Singleline}"
                              IsChecked="{Binding ViewModel.Singleline}" Margin="0,0,16,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    <CheckBox Content="{DynamicResource L.RegexTester.ExplicitCapture}"
                              IsChecked="{Binding ViewModel.ExplicitCapture}" Margin="0,0,16,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                    <CheckBox Content="{DynamicResource L.RegexTester.IgnoreWhitespace}"
                              IsChecked="{Binding ViewModel.IgnorePatternWhitespace}" Margin="0,0,16,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                    <CheckBox Content="{DynamicResource L.RegexTester.ReplaceMode}"
                              IsChecked="{Binding ViewModel.ReplaceMode}" Margin="0,0,0,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                </WrapPanel>

                <Grid Margin="0,0,0,8"
                      Visibility="{Binding ViewModel.ReplaceMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.RegexTester.Label.Replace}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ViewModel.ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Height="32" Padding="8" TabIndex="8"/>
                </Grid>

                <UniformGrid Columns="5" Margin="0,6,0,0">
                    <Button Command="{Binding ViewModel.TestCommand}"
                            Content="{DynamicResource L.RegexTester.Test}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="9"/>
                    <Button Command="{Binding ViewModel.TestCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="10"
                            Visibility="{Binding ViewModel.TestCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding ViewModel.CopyHighlightedCommand}"
                            Content="{DynamicResource L.RegexTester.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="11"/>
                    <Button Command="{Binding ViewModel.SaveHighlightedCommand}"
                            Content="{DynamicResource L.RegexTester.Save}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="12"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.RegexTester.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="13"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource L.RegexTester.Label.Input}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding ViewModel.Input, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Padding="8" TabIndex="14"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding ViewModel.MatchCount, StringFormat='{}{0} matches'}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,4"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ViewModel.Matches}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              MaxHeight="150" HeadersVisibility="Column"
                              Background="{StaticResource OptionsBgBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              GridLinesVisibility="Horizontal"
                              TabIndex="15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Idx" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="Len" Binding="{Binding Length}" Width="50"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource L.RegexTester.Label.Highlighted}"
                               Style="{StaticResource LabelPrimary}" Margin="0,8,0,4"/>
                    <Border Grid.Row="3"
                            Background="{StaticResource OptionsBgBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <TextBlock Text="{Binding ViewModel.Highlighted}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>