<UserControl x:Class="tool_cantam.Views.UnixTimestampPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.UnixTimestamp.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: Timestamp → Date -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Section.ToDate}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Timestamp}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ViewModel.TimestampInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35" Padding="10,6"
                                     FontFamily="{StaticResource MonoFont}"
                                     Background="{StaticResource OptionsBgBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderDefaultBrush}"
                                     TabIndex="0"
                                     AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.TimestampInput}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding ViewModel.UseNowCommand}"
                                    Content="{DynamicResource L.UnixTimestamp.Now}"
                                    Width="70" Height="35" Margin="8,0,0,0"
                                    Style="{StaticResource ModernButton}"
                                    Background="{StaticResource AccentPrimaryBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TabIndex="1"/>
                        </Grid>

                        <Button Command="{Binding ViewModel.TimestampToDateCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Convert}"
                                Height="29" Margin="0,0,0,8"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource GreenBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="2"
                                AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.ConvertToDate}"/>

                        <Button Command="{Binding ViewModel.TimestampToDateCancelCommand}"
                                Content="{DynamicResource L.Common.Cancel}"
                                Height="30" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="3"
                                Visibility="{Binding ViewModel.TimestampToDateCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Readable}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ViewModel.ReadableOutput}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,6"/>
                        <Button Command="{Binding ViewModel.CopyReadableCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Copy}"
                                Height="23" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource OptionsBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="4"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Iso}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ViewModel.IsoOutput}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,6"/>
                        <Button Command="{Binding ViewModel.CopyIsoCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Copy}"
                                Height="23" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource OptionsBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="5"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Rfc}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ViewModel.RfcOutput}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,6"/>
                        <Button Command="{Binding ViewModel.CopyRfcCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Copy}"
                                Height="23" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource OptionsBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="6"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- SAĞ: Date → Timestamp -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Section.ToTimestamp}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Date}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>

                        <TextBox Text="{Binding ViewModel.DateInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Padding="10,6" Margin="0,0,0,10"
                                 FontFamily="{StaticResource MonoFont}"
                                 Background="{StaticResource OptionsBgBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDefaultBrush}"
                                 TabIndex="7"
                                 AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.DateInput}"/>

                        <Button Command="{Binding ViewModel.DateToTimestampCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Convert}"
                                Height="30" Margin="0,0,0,8"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource GreenBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="8"
                                AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.ConvertToTimestamp}"/>

                        <Button Command="{Binding ViewModel.DateToTimestampCancelCommand}"
                                Content="{DynamicResource L.Common.Cancel}"
                                Height="30" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="9"
                                Visibility="{Binding ViewModel.DateToTimestampCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Seconds}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ViewModel.UnixSecondsOutput}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="16"
                                   FontWeight="Bold" MinHeight="20" Margin="0,0,0,6"/>
                        <Button Command="{Binding ViewModel.CopySecondsCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Copy}"
                                Height="23" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource OptionsBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="10"/>

                        <TextBlock Text="{DynamicResource L.UnixTimestamp.Label.Millis}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ViewModel.UnixMillisOutput}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   FontWeight="Bold" MinHeight="20" Margin="0,0,0,6"/>
                        <Button Command="{Binding ViewModel.CopyMillisCommand}"
                                Content="{DynamicResource L.UnixTimestamp.Copy}"
                                Height="23" Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource OptionsBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TabIndex="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Alt: Current + Unit/Mode + Clear -->
        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource L.UnixTimestamp.Label.Current}"
                           Style="{StaticResource LabelSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.CurrentTimestamp}"
                           Style="{StaticResource LabelPrimary}"
                           FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                           FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding ViewModel.Units}"
                          SelectedItem="{Binding ViewModel.Unit}"
                          Width="120" Margin="16,0,0,0"
                          TabIndex="12"
                          AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.Unit}" VerticalAlignment="Stretch"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding ViewModel.Modes}"
                          SelectedItem="{Binding ViewModel.Mode}"
                          Width="100" Height="37" Margin="8,0,0,0"
                          TabIndex="13"
                          AutomationProperties.Name="{DynamicResource L.UnixTimestamp.Automation.Mode}"/>

                <Button Grid.Column="4"
                        Command="{Binding ViewModel.ClearCommand}"
                        Content="{DynamicResource L.UnixTimestamp.Clear}"
                        Height="37" Width="100" Margin="16,0,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource RedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        TabIndex="14" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Durum -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>