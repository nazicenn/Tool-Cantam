<UserControl x:Class="tool_cantam.Views.HashIdentifierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.HashIdentifier.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Girdi -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.HashIdentifier.InputLabel}"
                           Style="{StaticResource LabelPrimary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="InputTextBox"
                         Text="{Binding ViewModel.HashInput, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource MonoFont}"
                         Height="34"
                         VerticalContentAlignment="Center"
                         TabIndex="0"
                         AutomationProperties.Name="{DynamicResource L.HashIdentifier.InputAutomationName}"/>
            </StackPanel>
        </Border>

        <!-- Eylemler -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Button Content="{DynamicResource L.HashIdentifier.Identify}"
                    Command="{Binding ViewModel.IdentifyCommand}"
                    Style="{StaticResource ModernButton}"
                    Background="{StaticResource GreenBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Height="34" Margin="0,0,5,0"
                    TabIndex="1"/>
            <Button Content="{DynamicResource L.HashIdentifier.Copy}"
                    Command="{Binding ViewModel.CopyResultsCommand}"
                    Style="{StaticResource ModernButton}"
                    Background="{StaticResource StatusWarningBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Height="34" Margin="5,0,5,0"
                    TabIndex="2"/>
            <Button Content="{DynamicResource L.HashIdentifier.Clear}"
                    Command="{Binding ViewModel.ClearCommand}"
                    Style="{StaticResource ModernButton}"
                    Background="{StaticResource RedBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Height="34" Margin="5,0,5,0"
                    TabIndex="3"/>
            <Button Content="{DynamicResource L.Common.Cancel}"
                    Command="{Binding ViewModel.IdentifyCancelCommand}"
                    Style="{StaticResource ModernButton}"
                    Background="{StaticResource StatusDangerBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Height="34" Margin="5,0,0,0"
                    TabIndex="4"
                    Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </UniformGrid>

        <!-- Özet ve uyarılar -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="{Binding ViewModel.SummaryText}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <!-- Biçimden tanımlama kesin değildir -->
            <TextBlock Text="{DynamicResource L.HashIdentifier.AmbiguousNote}"
                       Foreground="{StaticResource StatusWarningBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ViewModel.IsAmbiguous, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Adaylar -->
        <Border Grid.Row="4"
                Background="{StaticResource OptionsBgBrush}"
                BorderBrush="{StaticResource OptionsBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ViewModel.Candidates}"
                              AutomationProperties.Name="{DynamicResource L.HashIdentifier.CandidatesAutomationName}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Algorithm}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8,1"
                                        BorderBrush="{Binding Confidence, Converter={StaticResource HashIdentifierConfidenceToBrushConverter}}">
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               Foreground="{Binding Confidence, Converter={StaticResource HashIdentifierConfidenceToBrushConverter}}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- DURUM SATIRI -->
        <Border Grid.Row="5"
                Style="{StaticResource OptionsPanel}"
                Padding="12"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="True"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Grid.Column="2"
                           Text="{DynamicResource L.HashIdentifier.Hint}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           MaxWidth="420"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
