<UserControl x:Class="tool_cantam.Views.PingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.Ping.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Hedef ve ayarlar -->
        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.Ping.Target}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetTextBox"
                             Text="{Binding ViewModel.TargetHost, UpdateSourceTrigger=PropertyChanged}"
                             Width="240" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,15,0" TabIndex="0"
                             AutomationProperties.Name="{DynamicResource L.Ping.TargetAutomationName}"/>

                    <TextBlock Text="{DynamicResource L.Ping.Count}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ViewModel.Count, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,15,0" TabIndex="1"/>

                    <TextBlock Text="{DynamicResource L.Ping.Timeout}"
                               Style="{StaticResource LabelPrimary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ViewModel.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="32" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             Margin="0,0,15,0" TabIndex="2"/>

                    <Button Content="{DynamicResource L.Ping.Start}"
                            Command="{Binding ViewModel.PingCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="32" MinWidth="100" TabIndex="3"/>
                </StackPanel>

                <TextBlock Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuçlar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource L.Ping.Results}" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.SummaryText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </Grid>

            <!-- İstatistikler -->
            <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,0,0,10">
                <UniformGrid Columns="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.Sent}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <TextBlock Text="{Binding ViewModel.Sent}" Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.Received}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <TextBlock Text="{Binding ViewModel.Received}" Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.Lost}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <TextBlock Text="{Binding ViewModel.Lost}" Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.PacketLoss}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <TextBlock Text="{Binding ViewModel.PacketLoss, StringFormat={}{0}%}" Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.MinAvgMax}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <TextBlock Style="{StaticResource LabelPrimary}" FontWeight="Bold">
                            <Run Text="{Binding ViewModel.MinText, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding ViewModel.AvgText, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding ViewModel.MaxText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Ping.Progress}" Style="{StaticResource LabelSecondary}" FontSize="10"/>
                        <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding ViewModel.ProgressPercent}" Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Liste -->
            <Border Grid.Row="2"
                    Background="{StaticResource OptionsBgBrush}"
                    BorderBrush="{StaticResource OptionsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ViewModel.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sequence}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RttText}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Address}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt bar -->
        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Button Content="{DynamicResource L.Ping.Copy}"
                            Command="{Binding ViewModel.CopyResultsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="0,0,5,0" TabIndex="4"/>
                    <Button Content="{DynamicResource L.Ping.Save}"
                            Command="{Binding ViewModel.SaveResultCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="5"/>
                    <Button Content="{DynamicResource L.Ping.Clear}"
                            Command="{Binding ViewModel.ClearCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,5,0" TabIndex="6"/>
                    <Button Content="{DynamicResource L.Common.Cancel}"
                            Command="{Binding ViewModel.PingCancelCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusDangerBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Height="34" Margin="5,0,0,0" TabIndex="7"
                            Visibility="{Binding ViewModel.IsPinging, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding ViewModel.IsPinging, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.StatusText}"
                               Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>