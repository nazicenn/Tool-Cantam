<UserControl x:Class="tool_cantam.Views.JwtGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.JwtGenerator.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <!-- Secret Key -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.JwtGenerator.SecretKey}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ViewModel.SecretKey}"
                             FontFamily="{StaticResource MonoFont}"
                             Height="34" Padding="8,6"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             TabIndex="0"/>
                    <Button Grid.Column="2"
                            Command="{Binding ViewModel.GenerateStrongKeyCommand}"
                            Content="{DynamicResource L.JwtGenerator.Random}"
                            Height="34" Width="110" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="1"/>
                </Grid>

                <!-- Issuer / Audience -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.JwtGenerator.Issuer}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ViewModel.Issuer}"
                             Height="34" Padding="8,6"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             TabIndex="2"/>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource L.JwtGenerator.Audience}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding ViewModel.Audience}"
                             Height="34" Padding="8,6"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             TabIndex="3"/>
                </Grid>

                <!-- Expiry / Algorithm -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.JwtGenerator.Expiry}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:NumberBox Grid.Column="1"
                                  Value="{Binding ViewModel.ExpiryMinutes}"
                                  Minimum="1" Maximum="43200"
                                  ClearButtonEnabled="False"
                                  Width="130" Height="34"
                                  Padding="8,4"
                                  VerticalContentAlignment="Center"
                                  TabIndex="4"/>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource L.JwtGenerator.Algorithm}"
                               Style="{StaticResource LabelSecondary}"
                               VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding ViewModel.Algorithms}"
                              SelectedItem="{Binding ViewModel.Algorithm}"
                              Width="140" Height="34"
                              Padding="8,4"
                              VerticalContentAlignment="Center"
                              HorizontalAlignment="Left"
                              TabIndex="5"/>
                </Grid>

                <!-- Claims -->
                <TextBlock Text="{DynamicResource L.JwtGenerator.Claims}"
                           Style="{StaticResource LabelSecondary}"
                           Margin="0,4,0,4"/>
                <TextBox Text="{Binding ViewModel.Claims, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="70" Padding="8,6"
                         FontFamily="{StaticResource MonoFont}"
                         Background="{StaticResource OptionsBgBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderDefaultBrush}"
                         VerticalScrollBarVisibility="Auto"
                         TabIndex="6"
                         Margin="0,0,0,10"/>

                <!-- Butonlar -->
                <UniformGrid Columns="5" Margin="0,0,0,0">
                    <Button Command="{Binding ViewModel.GenerateCommand}"
                            Content="{DynamicResource L.JwtGenerator.Generate}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="7"/>
                    <Button Command="{Binding ViewModel.GenerateCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="8"
                            Visibility="{Binding ViewModel.GenerateCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding ViewModel.LoadSampleCommand}"
                            Content="{DynamicResource L.JwtGenerator.Sample}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="9"/>
                    <Button Command="{Binding ViewModel.CopyTokenCommand}"
                            Content="{DynamicResource L.JwtGenerator.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="10"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.JwtGenerator.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="11"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource L.JwtGenerator.Label.Token}"
                           Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{StaticResource OptionsBgBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <TextBlock Text="{Binding ViewModel.GeneratedToken}"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>