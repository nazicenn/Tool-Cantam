<UserControl x:Class="tool_cantam.Views.QrCodeReaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:tool_cantam.Helpers"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.QrCodeReader.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource DropZone}" Height="140" Margin="0,0,0,10"
                                helpers:FileDragDropBehavior.IsEnabled="True"
                                helpers:FileDragDropBehavior.FilePath="{Binding ViewModel.FilePath, Mode=TwoWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="32"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L.QrCodeReader.DropHint}"
                                           Style="{StaticResource DropZoneHint}"
                                           Margin="0,8,0,0" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="{Binding ViewModel.FilePathDisplay}"
                                           Style="{StaticResource LabelSecondary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding ViewModel.SelectFileCommand}"
                                Content="{DynamicResource L.QrCodeReader.SelectFile}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource AccentPrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Height="35" Margin="0,0,0,10" TabIndex="0"/>

                        <Button Command="{Binding ViewModel.ReadCommand}"
                                Content="{DynamicResource L.QrCodeReader.Read}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource GreenBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Height="38" Margin="0,0,0,8" TabIndex="1"
                                AutomationProperties.Name="{DynamicResource L.QrCodeReader.Automation.Read}"/>

                        <Button Command="{Binding ViewModel.ReadCancelCommand}"
                                Content="{DynamicResource L.Common.Cancel}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Height="30" Margin="0,0,0,10" TabIndex="2"
                                Visibility="{Binding ViewModel.ReadCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="{DynamicResource L.QrCodeReader.Label.Preview}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource OptionsBgBrush}" CornerRadius="8"
                                Padding="6" Height="160"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                            <Image Source="{Binding ViewModel.PreviewImage}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource L.QrCodeReader.Label.Result}"
                                   Style="{StaticResource LabelPrimary}"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding ViewModel.Format}"
                                   Style="{StaticResource LabelSecondary}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Margin="0,0,0,8"/>

                        <Border Background="{StaticResource OptionsBgBrush}"
                                CornerRadius="6" Padding="10" MinHeight="240"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <TextBlock Text="{Binding ViewModel.QrText}"
                                           Style="{StaticResource LabelPrimary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource L.QrCodeReader.Automation.Result}"/>
                            </ScrollViewer>
                        </Border>

                        <Button Command="{Binding ViewModel.CopyResultCommand}"
                                Content="{DynamicResource L.QrCodeReader.Copy}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Height="35" Margin="0,10,0,8" TabIndex="3"/>

                        <Button Command="{Binding ViewModel.ClearCommand}"
                                Content="{DynamicResource L.QrCodeReader.Clear}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource RedBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Height="35" TabIndex="4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ViewModel.StatusText}"
                           Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>