<!-- Views/UuidGeneratorPage.xaml -->
<UserControl x:Class="tool_cantam.Views.UuidGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="UUID GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Options -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Count:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ui:NumberBox Grid.Column="1" Value="{Binding Count}" Minimum="1" Maximum="100"/>
                </Grid>

                <WrapPanel>
                    <CheckBox Content="Uppercase" IsChecked="{Binding Uppercase}" Margin="0,0,20,5"/>
                    <CheckBox Content="Include Braces { }" IsChecked="{Binding IncludeBraces}" Margin="0,0,20,5"/>
                    <CheckBox Content="Include Hyphens" IsChecked="{Binding IncludeHyphens}" Margin="0,0,0,5"/>
                </WrapPanel>

                <UniformGrid Columns="3" Margin="0,10,0,0">
                    <Button Command="{Binding GenerateCommand}" 
                            Content="GENERATE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Grid.Row="2" 
                Padding="15">
            <StackPanel>
                <TextBlock Text="GENERATED UUIDs" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                    <TextBox Text="{Binding Output}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             FontFamily="Consolas"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>