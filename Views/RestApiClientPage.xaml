<!-- Views/RestApiClientPage.xaml -->
<UserControl x:Class="tool_cantam.Views.RestApiClientPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="REST API CLIENT" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Request -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="URL:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Method}" Width="80" Height="32" Margin="10,0">
                        <ComboBoxItem>GET</ComboBoxItem>
                        <ComboBoxItem>POST</ComboBoxItem>
                        <ComboBoxItem>PUT</ComboBoxItem>
                        <ComboBoxItem>DELETE</ComboBoxItem>
                        <ComboBoxItem>PATCH</ComboBoxItem>
                    </ComboBox>
                    <TextBox Grid.Column="2" Text="{Binding Url}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <TextBlock Text="Headers:" Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Headers}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" FontFamily="Consolas" Margin="0,0,0,10"/>

                <StackPanel Visibility="{Binding IsBodyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Body:" Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Body}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" FontFamily="Consolas" Margin="0,0,0,10"/>
                </StackPanel>

                <UniformGrid Columns="4" Margin="0,0,0,0">
                    <Button Command="{Binding SendCommand}" 
                            Content="SEND" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding CopyCurlCommand}" 
                            Content="COPY CURL" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding LoadSampleGetCommand}" 
                            Content="GET SAMPLE" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding LoadSamplePostCommand}" 
                            Content="POST SAMPLE" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Response -->
        <Border Grid.Row="2" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource LabelSecondary}" Margin="0,0,10,0"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" MinWidth="60">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource StatusWarningBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="200">
                                        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource StatusWarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="404">
                                        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="500">
                                        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusCode}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource LabelSecondary}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ResponseTime}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                </Grid>

                <TextBlock Text="Response Headers:" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="100" Margin="0,0,0,10">
                    <TextBox Text="{Binding ResponseHeaders}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>

                <TextBlock Text="Response Body:" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                    <TextBox Text="{Binding Response}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>

                <Button Command="{Binding CopyResponseCommand}" 
                        Content="📋 COPY RESPONSE" Height="30" Width="130" Margin="0,10,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusMessage}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>