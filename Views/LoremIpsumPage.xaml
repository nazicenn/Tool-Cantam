<!-- Views/LoremIpsumPage.xaml -->
<UserControl x:Class="tool_cantam.Views.LoremIpsumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="LOREM IPSUM GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Options -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Paragraphs:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" 
                            Minimum="1" Maximum="50" 
                            Value="{Binding ParagraphCount, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <TextBox Grid.Column="2" 
                             Text="{Binding ParagraphCount, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center"
                             FontFamily="Consolas"
                             Height="30"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sentences/Paragraph:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" 
                            Minimum="1" Maximum="20" 
                            Value="{Binding SentenceCount, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <TextBox Grid.Column="2" 
                             Text="{Binding SentenceCount, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center"
                             FontFamily="Consolas"
                             Height="30"/>
                </Grid>

                <CheckBox Content="Start with 'Lorem ipsum dolor sit amet'" 
                          IsChecked="{Binding StartWithLorem}" 
                          Margin="0,5,0,10"/>

                <UniformGrid Columns="3">
                    <Button Command="{Binding GenerateCommand}" 
                            Content="GENERATE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- OUTPUT - GÖRÜNÜR SCROLL BAR, SAYFADAN TAŞMAZ -->
        <Border Grid.Row="2" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="OUTPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <TextBox Text="{Binding OutputText, Mode=OneWay}" 
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="200"
                             FontFamily="Consolas"
                             FontSize="12"
                             BorderThickness="0"
                             Background="Transparent"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>