<!-- Views/FindReplacePage.xaml -->
<UserControl x:Class="tool_cantam.Views.FindReplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="FIND AND REPLACE" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Find/Replace Inputs -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Find:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding FindText}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Replace:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ReplaceText}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <WrapPanel Margin="0,0,0,10">
                    <CheckBox Content="Match Case" IsChecked="{Binding MatchCase}" Margin="0,0,20,5"/>
                    <CheckBox Content="Match Whole Word" IsChecked="{Binding MatchWholeWord}" Margin="0,0,0,5"/>
                </WrapPanel>

                <TextBlock Text="Replacements: " Style="{StaticResource LabelSecondary}">
                    <Run Text="{Binding ReplaceCount}"/>
                </TextBlock>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Command="{Binding ReplaceCommand}" 
                            Content="REPLACE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding SwapCommand}" 
                            Content="SWAP" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Input/Output -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="INPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding InputText}" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="OUTPUT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding OutputText}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>