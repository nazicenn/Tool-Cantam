<!-- Views/CsvToJsonPage.xaml -->
<UserControl x:Class="tool_cantam.Views.CsvToJsonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="CSV TO JSON" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Settings -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <WrapPanel>
                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Separator:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding Separator}" Width="80" Height="30">
                            <ComboBoxItem>,</ComboBoxItem>
                            <ComboBoxItem>;</ComboBoxItem>
                            <ComboBoxItem>\t</ComboBoxItem>
                            <ComboBoxItem>|</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <CheckBox Content="First Row as Header" IsChecked="{Binding FirstRowAsHeader}" VerticalAlignment="Center"/>
                </WrapPanel>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Command="{Binding ConvertCommand}" 
                            Content="CONVERT" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding LoadSampleCommand}" 
                            Content="SAMPLE" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Input/Output -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input CSV -->
            <Border Grid.Column="0" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="INPUT CSV" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding InputCsv, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="300"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Output JSON -->
            <Border Grid.Column="1" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="OUTPUT JSON" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding OutputJson}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MinHeight="300"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                    <Button Command="{Binding CopyOutputCommand}" 
                            Content="COPY OUTPUT" Height="30" Width="130" Margin="0,10,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>