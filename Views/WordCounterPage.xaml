<!-- Views/WordCounterPage.xaml -->
<UserControl x:Class="tool_cantam.Views.WordCounterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="WORD COUNTER PRO" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: INPUT -->
            <Border Grid.Column="0" 
                    Padding="15" 
                    Style="{StaticResource OptionsPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="INPUT TEXT" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="300"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </ScrollViewer>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0">
                        <Button Command="{Binding CopyStatisticsCommand}" 
                                Content="COPY STATS" Height="35" Margin="0,0,5,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"/>
                        <Button Command="{Binding CopyTextCommand}" 
                                Content="COPY TEXT" Height="35" Margin="5,0,5,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"/>
                        <Button Command="{Binding ClearCommand}" 
                                Content="CLEAR" Height="35" Margin="5,0,0,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource RedBrush}"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- SAĞ: İSTATİSTİKLER -->
            <Border Grid.Column="2" 
                    Padding="15"
                    Style="{StaticResource OptionsPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="STATISTICS" 
                                   Style="{StaticResource LabelPrimary}" 
                                   FontSize="14"
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,20"/>

                        <!-- Karakter -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Characters" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CharacterCount}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="No Spaces" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CharacterCountNoSpaces}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Words" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WordCount}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sentences" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SentenceCount}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Paragraphs" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ParagraphCount}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lines" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding LineCount}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Separator Margin="0,10,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📖 Reading" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ReadingTime}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎤 Speaking" 
                                       Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SpeakingTime}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </Grid>

                        <TextBlock Text="TOP WORDS" 
                                   Style="{StaticResource LabelPrimary}" 
                                   FontSize="11"
                                   Margin="0,15,0,5"/>
                        <TextBlock Text="{Binding TopWords}" 
                                   Style="{StaticResource LabelSecondary}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>