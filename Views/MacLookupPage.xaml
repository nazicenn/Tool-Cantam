<UserControl x:Class="tool_cantam.Views.MacLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="MAC ADDRESS LOOKUP" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <StackPanel>
                <TextBlock Text="MAC Address" 
                           Style="{StaticResource LabelPrimary}" 
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="example: 00:1A:2B:3C:4D:5E or 001A2B3C4D5E"/>

                    <Button Grid.Column="1" 
                            Command="{Binding LookupCommand}"
                            Content="LOOKUP"
                            Height="40"
                            Width="100"
                            Margin="10,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <!-- Formatlı MAC gösterimi -->
                <TextBlock Text="{Binding FormattedMac}" 
                           Style="{StaticResource LabelSecondary}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Margin="0,10,0,0"
                           Visibility="{Binding FormattedMac, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <ui:ProgressRing IsIndeterminate="True" 
                                     Width="16" 
                                     Height="16" 
                                     Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sonuç -->
                <!-- Sonuç - Visibility tamamen kaldırıldı -->
                <Border Style="{StaticResource OptionsPanel}"
        Margin="0,15,0,0"
        Padding="15">

                    <StackPanel>
                        <TextBlock Text="VENDOR / MANUFACTURER:" 
                   Style="{StaticResource LabelSecondary}" 
                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Vendor}" 
                   Style="{StaticResource LabelPrimary}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="13"
                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding CopyResultCommand}" 
                            Content="COPY RESULT"
                            Height="34" 
                            Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR"
                            Height="34" 
                            Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="🔍 MAC Address Lookup - Find vendor/manufacturer from MAC address (OUI lookup)"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>