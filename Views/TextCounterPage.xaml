<UserControl x:Class="tool_cantam.Views.TextCounterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="TEXT COUNTER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Input -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="INPUT TEXT" 
                               Style="{StaticResource LabelPrimary}" 
                               Margin="0,0,0,10"/>

                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="300"/>
                </StackPanel>

                <!-- Sağ: Results -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="RESULTS" 
                               Style="{StaticResource LabelPrimary}" 
                               Margin="0,0,0,10"/>

                    <Border Style="{StaticResource OptionsPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Characters:" Style="{StaticResource LabelSecondary}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding CharacterCount}" 
                                       Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OptionsPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Characters (no spaces):" Style="{StaticResource LabelSecondary}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding CharacterCountNoSpaces}" 
                                       Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OptionsPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Words:" Style="{StaticResource LabelSecondary}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding WordCount}" 
                                       Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OptionsPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lines:" Style="{StaticResource LabelSecondary}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding LineCount}" 
                                       Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OptionsPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paragraphs:" Style="{StaticResource LabelSecondary}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding ParagraphCount}" 
                                       Style="{StaticResource LabelPrimary}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Command="{Binding CopyResultsCommand}" 
                                Content="COPY RESULTS"
                                Height="34" 
                                Margin="0,0,5,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource StatusWarningBrush}"/>
                        <Button Command="{Binding ClearCommand}" 
                                Content="CLEAR"
                                Height="34" 
                                Margin="5,0,0,0"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource RedBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>