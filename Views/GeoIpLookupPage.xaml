<UserControl x:Class="tool_cantam.Views.GeoIpLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.GeoIpLookup.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource L.GeoIpLookup.IpAddress}" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ViewModel.IpAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="0"/>
                    <Button Grid.Column="2" Command="{Binding ViewModel.LookupCommand}" Content="{DynamicResource L.GeoIpLookup.Lookup}" Height="34" Width="100" Margin="8,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    <Button Grid.Column="3" Command="{Binding ViewModel.LookupMyIpCommand}" Content="{DynamicResource L.GeoIpLookup.MyIp}" Height="34" Width="100" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                </Grid>
                <UniformGrid Columns="2">
                    <Button Command="{Binding ViewModel.CopyResultsCommand}" Content="{DynamicResource L.GeoIpLookup.Copy}" Height="32" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                    <Button Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.GeoIpLookup.Clear}" Height="32" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource L.GeoIpLookup.Label.Results}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Country}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Country}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Region}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Region}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.City}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.City}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Zip}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.ZipCode}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Coordinates}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ViewModel.Latitude}"/>
                                <TextBlock Text=", "/>
                                <TextBlock Text="{Binding ViewModel.Longitude}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Isp}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Isp}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Org}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Organization}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Timezone}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.Timezone}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.GeoIpLookup.Proxy}" Style="{StaticResource LabelSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.IsProxy}" Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>