<UserControl x:Class="tool_cantam.Views.HashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:tool_cantam.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- Algorithm Seçici -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="HASH GENERATOR" Style="{StaticResource LabelPrimary}" 
                       FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ListBox ItemsSource="{Binding ViewModel.Algorithms}" SelectedItem="{Binding ViewModel.SelectedAlgorithm}" 
                     BorderThickness="0" Background="Transparent" HorizontalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Margin" Value="0,0,5,0"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>

        <!-- Input ve File Alanı -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Text Input -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Input Text" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>
                <ui:TextBox Grid.Row="1" Text="{Binding ViewModel.InputText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Enter text here..." TextWrapping="Wrap" AcceptsReturn="True"
                            VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto"/>
                <Button Grid.Row="2" Content="HASH TEXT" Command="{Binding ViewModel.ComputeTextCommand}" 
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource GreenBrush}"
                        Margin="0,8,0,0" Height="36"/>
            </Grid>

            <!-- Sağ: File Drop -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="File (Drag &amp; Drop)" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>
                <Border Grid.Row="1" Style="{StaticResource DropZone}" VerticalAlignment="Stretch"
                        helpers:FileDragDropBehavior.IsEnabled="True"
                        helpers:FileDragDropBehavior.FilePath="{Binding ViewModel.FilePath, Mode=TwoWay}">
                    <StackPanel VerticalAlignment="Center" Margin="5">
                        <ui:SymbolIcon Symbol="Document24" FontSize="28" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop file" Style="{StaticResource DropZoneHint}" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="2" Content="HASH FILE" Command="{Binding ViewModel.ComputeFileCommand}" 
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentPrimaryBrush}" 
                        Margin="0,8,0,0" Height="36"/>
            </Grid>
        </Grid>

        <!-- Output ve Validate Kısmı -->
        <Grid Grid.Row="3" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Separator Grid.Row="0" Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,5,0,15"/>

            <!-- Output Header + COPY -->
            <Grid Grid.Row="1" Margin="0,0,0,5">
                <TextBlock Text="Output Hash" Style="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                <Button Content="COPY" 
                        Command="{Binding ViewModel.CopyHashCommand}" 
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}" 
                        Width="70" Height="30" 
                        HorizontalAlignment="Right"
                        FontSize="10"/>
            </Grid>

            <!-- Hash Output -->
            <ui:TextBox Grid.Row="2" Text="{Binding ViewModel.HashOutput}" IsReadOnly="True" 
                        VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                        VerticalAlignment="Stretch" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Validate Label -->
            <TextBlock Grid.Row="3" Text="Validate / Compare Hash" Style="{StaticResource LabelPrimary}" Margin="0,0,0,5"/>

            <!-- Compare Input -->
            <ui:TextBox Grid.Row="4" Text="{Binding ViewModel.CompareHash, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Paste hash here to compare..."
                        VerticalAlignment="Stretch" TextWrapping="Wrap"/>

            <!-- Validation Result -->
            <TextBlock Grid.Row="5" Text="{Binding ViewModel.ValidationResult}" Style="{StaticResource SuccessText}" 
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </Grid>
    </Grid>
</UserControl>
