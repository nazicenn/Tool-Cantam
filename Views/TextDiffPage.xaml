<UserControl x:Class="tool_cantam.Views.TextDiffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="TEXT DIFF" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Options -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Content="Ignore Case" IsChecked="{Binding IgnoreCase}" Margin="0,0,20,5"/>
                    <CheckBox Content="Ignore Whitespace" IsChecked="{Binding IgnoreWhitespace}" Margin="0,0,0,5"/>
                </WrapPanel>

                <!-- Stats - Renkli yazılar -->
                <WrapPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,15,0">
                        <Run Text="Added: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding AddedLines}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,15,0">
                        <Run Text="Removed: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding RemovedLines}" Foreground="{StaticResource RedBrush}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Changed: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding ChangedLines}" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold"/>
                    </TextBlock>
                </WrapPanel>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Command="{Binding CompareCommand}" 
                            Content="COMPARE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding SwapCommand}" 
                            Content="SWAP" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                    <Button Command="{Binding CopyResultCommand}" 
                            Content="COPY" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Input Left/Right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ORIGINAL" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding LeftText}" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="MODIFIED" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding RightText}" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             MinHeight="250" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Result -->
        <Border Grid.Row="3" 
                Padding="15" 
                Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="DIFFERENCE" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150">
                    <TextBox Text="{Binding DiffResult}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             FontFamily="Consolas"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>