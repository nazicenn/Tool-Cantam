<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>tool_cantam</RootNamespace>
		<AssemblyName>tool-cantam</AssemblyName>
		<ApplicationIcon>Assets\tool-cantam.ico</ApplicationIcon>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DnsClient" Version="1.8.0" />
		<PackageReference Include="Markdig" Version="1.4.1" />
		<PackageReference Include="MetadataExtractor" Version="2.9.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
		<PackageReference Include="QRCoder" Version="1.8.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<PackageReference Include="Tomlyn" Version="2.10.1" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
		<PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
	</ItemGroup>

	<ItemGroup>
		<!-- Test projesi uygulama derlemesine dahil edilmez (kendi projesi ve derlemesi vardır). -->
		<Compile Remove="tests\**" />
		<None Remove="tests\**" />
		<Content Remove="tests\**" />
		<Page Remove="tests\**" />
		<ApplicationDefinition Remove="tests\**" />
	</ItemGroup>

</Project>