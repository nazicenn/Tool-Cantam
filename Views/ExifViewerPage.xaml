<!-- Views/ExifViewerPage.xaml -->
<UserControl x:Class="tool_cantam.Views.ExifViewerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:tool_cantam.Helpers"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="EXIF VIEWER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Dosya Yükleme -->
            <Border Grid.Column="0" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="IMAGE FILE" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    
                    <Border Style="{StaticResource DropZone}" 
                            Padding="20" MinHeight="150"
                            helpers:FileDragDropBehavior.IsEnabled="True"
                            helpers:FileDragDropBehavior.FilePath="{Binding FilePath, Mode=TwoWay}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Image24" FontSize="32" HorizontalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Drop image here" HorizontalAlignment="Center" Margin="0,10,0,5"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding FilePath, TargetNullValue='or click to select'}" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Command="{Binding LoadImageCommand}" 
                            Content="🔍 LOAD &amp; READ EXIF" 
                            Height="40" Margin="0,15,0,15"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    
                    <Border CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="PREVIEW" Style="{StaticResource LabelSecondary}" FontSize="11" Margin="0,0,0,5"/>
                            <Image Source="{Binding ImagePreview}" MaxHeight="150" Stretch="Uniform"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Orta: Butonlar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                <Button Command="{Binding CopyAllCommand}" 
                        Content="📋 COPY" Height="40" Width="80" Margin="0,5"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource StatusWarningBrush}"/>
                <Button Command="{Binding ClearCommand}" 
                        Content="🗑️ CLEAR" Height="40" Width="80" Margin="0,5"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource RedBrush}"/>
            </StackPanel>

            <!-- Sağ: EXIF Verileri -->
            <Border Grid.Column="2" 
                    Style="{StaticResource OptionsPanel}" 
                    Padding="15" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="EXIF DATA" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400">
                        <ItemsControl ItemsSource="{Binding Directories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                            CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" 
                                                       Style="{StaticResource LabelPrimary}" 
                                                       FontWeight="Bold" 
                                                       Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" 
                                                                       Text="{Binding Name}" 
                                                                       Style="{StaticResource LabelSecondary}"
                                                                       FontSize="11"/>
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Value}" 
                                                                       Style="{StaticResource LabelPrimary}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>