<UserControl x:Class="tool_cantam.Views.CategoryCardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="{Binding CategoryName, FallbackValue='TOOL CATEGORY'}" 
                       Style="{StaticResource LabelPrimary}" 
                       FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Select an utility from the list below." 
                       Style="{StaticResource LabelSecondary}" 
                       Margin="0,5,0,0" Opacity="0.8"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ToolsList" ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Height="140" Margin="0,0,15,15"
                                Background="{StaticResource GrayBrush}" 
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1.5" CornerRadius="8" 
                                Cursor="Hand"
                                MouseLeftButtonUp="Card_Click">

                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Code24" Grid.Column="0"
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" 
                                               Style="{StaticResource LabelPrimary}" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" 
                                               Style="{StaticResource LabelSecondary}" 
                                               FontSize="11" 
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>