<UserControl x:Class="tool_cantam.Views.ColorPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L.ColorPicker.Title}" Style="{StaticResource LabelPrimary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.ColorPicker.Preview}" Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <Border Width="200" Height="200" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="2">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding ViewModel.SelectedColor}"/>
                        </Border.Background>
                        <TextBlock Text="{Binding ViewModel.HexColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R:" Foreground="#FF5555" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Red}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" TabIndex="0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ViewModel.Red}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G:" Foreground="#55FF55" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Green}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" TabIndex="1"/>
                        <TextBlock Grid.Column="2" Text="{Binding ViewModel.Green}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B:" Foreground="#5555FF" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ViewModel.Blue}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" TabIndex="2"/>
                        <TextBlock Grid.Column="2" Text="{Binding ViewModel.Blue}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HEX:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ViewModel.HexColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Height="34" Padding="8,6" Margin="0,0,8,0" Background="{StaticResource OptionsBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" TabIndex="3"/>
                        <Button Grid.Column="2" Command="{Binding ViewModel.ApplyHexCommand}" Content="{DynamicResource L.ColorPicker.Apply}" Height="34" Width="90" Style="{StaticResource ModernButton}" Background="{StaticResource GreenBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="4"/>
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <Button Command="{Binding ViewModel.RandomColorCommand}" Content="{DynamicResource L.ColorPicker.Random}" Height="34" Margin="0,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="5"/>
                        <Button Command="{Binding ViewModel.CopyHexCommand}" Content="{DynamicResource L.ColorPicker.CopyHex}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="6"/>
                        <Button Command="{Binding ViewModel.CopyRgbCommand}" Content="{DynamicResource L.ColorPicker.CopyRgb}" Height="34" Margin="4,0,4,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="7"/>
                        <Button Command="{Binding ViewModel.CopyHslCommand}" Content="{DynamicResource L.ColorPicker.CopyHsl}" Height="34" Margin="4,0,0,0" Style="{StaticResource ModernButton}" Background="{StaticResource StatusWarningBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="8"/>
                    </UniformGrid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RGB:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.RgbColor}" FontFamily="{StaticResource MonoFont}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HSL:" Style="{StaticResource LabelSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.HslColor}" FontFamily="{StaticResource MonoFont}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.StatusText}" Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding ViewModel.ClearCommand}" Content="{DynamicResource L.ColorPicker.Clear}" Height="26" Width="90" Margin="8,0,8,0" Style="{StaticResource ModernButton}" Background="{StaticResource RedBrush}" Foreground="{StaticResource TextPrimaryBrush}" TabIndex="9"/>
                <TextBlock Grid.Column="3" Text="{Binding ViewModel.LimitsText}" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.6" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>