<UserControl x:Class="tool_cantam.Views.SslCheckerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <UserControl.Resources>
        <!-- Status için ortak stil -->
        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="SSL CERTIFICATE CHECKER" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Padding="20">

            <StackPanel>
                <TextBlock Text="Domain Name" 
                           Style="{StaticResource LabelPrimary}" 
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="1" 
                            Command="{Binding CheckCommand}"
                            Content="CHECK"
                            Height="40"
                            Width="100"
                            Margin="10,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <ui:ProgressRing IsIndeterminate="True" 
                                     Width="16" 
                                     Height="16" 
                                     Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Results -->
                <Border Style="{StaticResource OptionsPanel}"
                        Margin="0,15,0,0"
                        Padding="15">

                    <StackPanel>
                        <!-- BURASI DÜZELTİLDİ: Style çakışması BasedOn ile çözüldü -->
                        <TextBlock Text="{Binding CertificateInfo.Status}" 
                                   FontWeight="Bold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LabelPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CertificateInfo.IsValid}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CertificateInfo.IsValid}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subject:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.Subject}" 
                                       Style="{StaticResource LabelPrimary}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Issuer:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.Issuer}" 
                                       Style="{StaticResource LabelPrimary}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Valid From:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.NotBefore, StringFormat=yyyy-MM-dd}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Valid To:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.NotAfter, StringFormat=yyyy-MM-dd}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Remaining Days:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.RemainingDays}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Serial Number:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.SerialNumber}" 
                                       Style="{StaticResource LabelPrimary}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Algorithm:" Style="{StaticResource LabelSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateInfo.SignatureAlgorithm}" 
                                       Style="{StaticResource LabelPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Command="{Binding CopyResultsCommand}" 
                            Content="COPY ALL"
                            Height="34" 
                            Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding ClearCommand}" 
                            Content="CLEAR"
                            Height="34" 
                            Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" 
                   Text="🔒 SSL Certificate Checker - Verify SSL/TLS certificate details and expiration"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</UserControl>