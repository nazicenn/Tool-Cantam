<!-- Views/CurlGeneratorPage.xaml -->
<UserControl x:Class="tool_cantam.Views.CurlGeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="CURL GENERATOR" 
                   Style="{StaticResource LabelPrimary}" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Request Settings -->
        <Border Grid.Row="1" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="URL:" Style="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Method}" Width="80" Height="32" Margin="10,0">
                        <ComboBoxItem>GET</ComboBoxItem>
                        <ComboBoxItem>POST</ComboBoxItem>
                        <ComboBoxItem>PUT</ComboBoxItem>
                        <ComboBoxItem>DELETE</ComboBoxItem>
                        <ComboBoxItem>PATCH</ComboBoxItem>
                    </ComboBox>
                    <TextBox Grid.Column="2" Text="{Binding Url}" FontFamily="Consolas" Height="35"/>
                </Grid>

                <TextBlock Text="Headers:" Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Headers}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" FontFamily="Consolas" Margin="0,0,0,10"/>

                <StackPanel Visibility="{Binding IsBodyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Body:" Style="{StaticResource LabelSecondary}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Body}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" Margin="0,0,0,10"/>
                </StackPanel>

                <WrapPanel Margin="0,0,0,10">
                    <CheckBox Content="Include Headers" IsChecked="{Binding IncludeHeaders}" Margin="0,0,20,5"/>
                    <CheckBox Content="Include Body" IsChecked="{Binding IncludeBody}" Margin="0,0,0,5"/>
                </WrapPanel>

                <UniformGrid Columns="4" Margin="0,0,0,0">
                    <Button Command="{Binding GenerateCommand}" 
                            Content="GENERATE" Height="35" Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"/>
                    <Button Command="{Binding CopyCurlCommand}" 
                            Content="COPY" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding LoadSampleGetCommand}" 
                            Content="GET SAMPLE" Height="35" Margin="5,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                    <Button Command="{Binding LoadSamplePostCommand}" 
                            Content="POST SAMPLE" Height="35" Margin="5,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Grid.Row="2" 
                Style="{StaticResource OptionsPanel}" 
                Padding="15">
            <StackPanel>
                <TextBlock Text="CURL COMMAND" Style="{StaticResource LabelPrimary}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                    <TextBox Text="{Binding CurlCommand}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             FontFamily="Consolas"
                             FontSize="11"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>