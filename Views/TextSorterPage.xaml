<UserControl x:Class="tool_cantam.Views.TextSorterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource BorderDefaultBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L.TextSorter.Title}"
                   Style="{StaticResource LabelPrimary}"
                   FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource OptionsPanel}" Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Content="{DynamicResource L.TextSorter.IgnoreCase}"
                              IsChecked="{Binding ViewModel.IgnoreCase}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="0"/>
                    <CheckBox Content="{DynamicResource L.TextSorter.RemoveEmpty}"
                              IsChecked="{Binding ViewModel.RemoveEmptyLines}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="1"/>
                    <CheckBox Content="{DynamicResource L.TextSorter.Trim}"
                              IsChecked="{Binding ViewModel.TrimLines}" Margin="0,0,20,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="2"/>
                    <CheckBox Content="{DynamicResource L.TextSorter.RemoveDuplicates}"
                              IsChecked="{Binding ViewModel.RemoveDuplicates}" Margin="0,0,0,5"
                              Foreground="{StaticResource TextPrimaryBrush}" TabIndex="3"/>
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource L.TextSorter.Label.Direction}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.Directions}"
                                  SelectedItem="{Binding ViewModel.Direction}"
                                  Height="37" TabIndex="4"
                                  AutomationProperties.Name="{DynamicResource L.TextSorter.Automation.Direction}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource L.TextSorter.Label.Mode}"
                                   Style="{StaticResource LabelSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.Modes}"
                                  SelectedItem="{Binding ViewModel.Mode}"
                                  Height="37" TabIndex="5"
                                  AutomationProperties.Name="{DynamicResource L.TextSorter.Automation.Mode}"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="5" Margin="0,12,0,0">
                    <Button Command="{Binding ViewModel.SortCommand}"
                            Content="{DynamicResource L.TextSorter.Sort}"
                            Height="35" Margin="0,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource GreenBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="6"
                            AutomationProperties.Name="{DynamicResource L.TextSorter.Automation.Sort}"/>
                    <Button Command="{Binding ViewModel.SortCancelCommand}"
                            Content="{DynamicResource L.Common.Cancel}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="7"
                            Visibility="{Binding ViewModel.SortCancelCommand.CanExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding ViewModel.CopyOutputCommand}"
                            Content="{DynamicResource L.TextSorter.Copy}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource StatusWarningBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="8"/>
                    <Button Command="{Binding ViewModel.SaveOutputCommand}"
                            Content="{DynamicResource L.TextSorter.Save}"
                            Height="35" Margin="4,0,4,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="9"/>
                    <Button Command="{Binding ViewModel.ClearCommand}"
                            Content="{DynamicResource L.TextSorter.Clear}"
                            Height="35" Margin="4,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource RedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TabIndex="10"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT -->
            <Border Grid.Column="0" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource L.TextSorter.Label.Input}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding ViewModel.InputText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{StaticResource OptionsBgBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             Padding="8"
                             TabIndex="11"
                             AutomationProperties.Name="{DynamicResource L.TextSorter.Automation.Input}"/>
                </Grid>
            </Border>

            <!-- OUTPUT -->
            <Border Grid.Column="2" Style="{StaticResource OptionsPanel}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource L.TextSorter.Label.Output}"
                               Style="{StaticResource LabelPrimary}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1"
                            Background="{StaticResource OptionsBgBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <TextBlock Text="{Binding ViewModel.OutputText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource L.TextSorter.Automation.Output}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource OptionsPanel}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.StatusText}"
                               Foreground="{Binding ViewModel.StatusType, Converter={StaticResource NotificationTypeToBrushConverter}}"
                               FontSize="11" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ViewModel.LineInfoText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Opacity="0.7" FontSize="10" FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding ViewModel.LimitsText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.6" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>